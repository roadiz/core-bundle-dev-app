{#
 # Character quota of the current translate-assistant provider.
 # Renders nothing when no provider is wired, or when the provider exposes no quota.
 # Callers provide their own heading.
 #}
{% if translateAssistantEnabled %}
    {% set assistantUsage = translateAssistantUsage() %}
    {% if assistantUsage %}
        {% set usagePercentage = assistantUsage.percentage %}
        {% set usageState = assistantUsage.isLimitReached ? 'uk-progress-danger' : (usagePercentage >= 80 ? 'uk-progress-warning' : '') %}
        <div class="translate-assistant-usage">
            <div class="uk-text-small uk-text-muted" style="display: flex; justify-content: space-between; gap: 10px;">
                <span>{{ 'translate_assistant.usage.%count%_of_%limit%_characters'|trans({
                    '%count%': assistantUsage.characterCount|number_format(0, '.', ' '),
                    '%limit%': assistantUsage.characterLimit|number_format(0, '.', ' '),
                }) }}</span>
                <span>{{ usagePercentage|round }} %</span>
            </div>
            {# UIkit 2 progress component, already bundled through vendor.less #}
            <div class="uk-progress uk-progress-mini {{ usageState }}" style="margin: 5px 0 0;">
                <div class="uk-progress-bar" style="width: {{ usagePercentage|round(1) }}%;{% if usageState is empty %} background: var(--rz-accent-color, #00deab);{% endif %}"></div>
            </div>
        </div>
    {% endif %}
{% endif %}
