{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{% trans %}nodeTypes{% endtrans %} | {{ parent() }}{% endblock %}

{% block content %}
    <section class="content-global content-nav-and-filters">
        {% include '@RoadizRozier/node-types/head.html.twig' with {
            title: 'nodeTypes'|trans,
            filters: filters,
            buttons: [
                {
                    label: 'manage.decorators'|trans,
                    attributes: {
                        href: path('nodeTypeDecoratorsListPage'),
                    },
                    iconClass: 'rz-icon-ri--paint-brush-line',
                },
                {
                    label: 'export.documentation'|trans,
                    attributes: {
                        class: 'rz-no-ajax-link',
                        href: path('nodesTypesExportDocumentationPage'),
                    },
                    iconClass: 'rz-icon-ri--download-cloud-2-line',},
                {
                    label: 'export.typescript_declaration'|trans,
                    attributes: {
                        class: 'rz-no-ajax-link',
                        href: path('nodesTypesExportTypeScriptPage'),
                    },
                    iconClass: 'rz-icon-ri--download-cloud-2-line',}
            ],
        } only %}

        <article>
             {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
                selectionAvailable: false,
                actionsAvailable: true,
            } %}
                {% block thead_cells %}
                    {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
                    <th>
                        {{ rz_table.column_ordering({
                            label: 'name'|trans,
                            field: 'name',
                            filters: filters|default(null),
                        }) }}
                    </th>
                    <th class="mobile-hidden">{% trans %}nodeType.displayName{% endtrans %}</th>
                    <th class="mobile-hidden rz-table__cell--from-lg">{% trans %}nodeType.entityName{% endtrans %}</th>
                    <th class="mobile-hidden">{% trans %}nodeType.numberFields{% endtrans %}</th>
                    <th class="mobile-hidden">{% trans %}nodeType.status{% endtrans %}</th>
                {% endblock %}

                {% block tbody_content %}
                 {%- for type in node_types -%}
                        {% set classes = ['node-type-item'] %}
                        {% if not type.reachable %}
                            {% set classes = classes|merge(['not-reachable']) %}
                        {% endif %}
                        {% if not type.visible %}
                            {% set classes = classes|merge(['not-visible']) %}
                        {% endif %}
                        {% if type.hidingNodes %}
                            {% set classes = classes|merge(['hiding-children']) %}
                        {% endif %}

                        <tr
                             {{ _self.colored_row_attrs({'color': type.color }) }}
                        >
                            <td>
                                {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
                                {{ rz_link.root({
                                    label: type.getName,
                                    attributes: { href: path('nodeTypeFieldsListPage', { nodeTypeName: type.getName }) },
                                }) }}
                            </td>
                            <td class="mobile-hidden">{{ type.getDisplayName }}</td>
                            <td class="mobile-hidden rz-table__cell--from-lg">{{ type.getSourceEntityClassName }}</td>
                            <td class="mobile-hidden">
                                {% transchoice type.getFields|length %}{0} no.nodeTypeField|{1} 1.nodeTypeField|]1,Inf] %count%.nodeTypeFields{% endtranschoice %}
                            </td>
                            <td class="mobile-hidden">
                                {% import '@RoadizRozier/ui/components/rz_node_badge.html.twig' as rz_node_badge %}
                                {% if not type.visible %}
                                    {{ rz_node_badge.root({ type: 'hidden', displayLabel: false }) }}
                                {% endif %}
                                {% if type.hidingNodes %}
                                    {{ rz_node_badge.root({ type: 'hiding-nodes', displayLabel: false }) }}
                                {% endif %}
                                {%- if type.highlighted -%}
                                    {{ rz_node_badge.root({ type: 'highlighted', displayLabel: false }) }}
                                {%- endif -%}
                            </td>
                            {% if actionsAvailable %}
                                <td>
                                    {% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' %}
                                        {% block other_actions %}
                                            {{ _self.button({
                                                iconClass: 'rz-icon-ri--input-field',
                                                attributes: {
                                                    href: path('nodeTypeFieldsListPage', { nodeTypeName: type.name }),
                                                    title: 'manage.nodeTypeFields'|trans,
                                                }
                                            }) }}
                                            {{ _self.button({
                                                iconClass: 'rz-icon-ri--add-line',
                                                attributes: {
                                                    href: path('nodeTypeDecoratorsAddPage', {'nodeTypeName': type.name}),
                                                    title: 'add.a.nodeTypeDecorator'|trans,
                                                }
                                            }) }}
                                        {% endblock %}
                                    {% endembed %}
                                </td>
                            {% endif %}
                        </tr>
                    {%- endfor -%}
                {% endblock %}
            {% endembed %}
        </article>
    </section>
{% endblock %}
