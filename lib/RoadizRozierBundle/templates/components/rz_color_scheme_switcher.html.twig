{% set popover_id = "color-theme-switcher" %}
{% embed "@RoadizRozier/components/rz_dropdown.html.twig" with {
	targetId: popover_id,
	wrapper_tag: 'rz-color-scheme-switcher',
	target_options: {
		size: 'sm',
		icon: 'rz-icon-ri--color-filter-line',
		attributes: {
			'aria-label': 'show.color.theme'|trans,
		},
	},
	popover_attributes: {
		class: class|default(''),
	},
} %}
	{% block items %}
		{{ _self.item({
			selected: true,
			label: 'color.system'|trans,
			rightIcon: 'rz-icon-ri--computer-line',
			attributes: {
				type: 'button',
				'data-value': 'system',
				command: '--update-color-scheme',
				commandfor: popover_id,
			}
		}) }}
		{{ _self.item({
			label: 'color.light'|trans,
			rightIcon: 'rz-icon-ri--sun-line',
			attributes: {
				type: 'button',
				'data-value': 'light',
				command: '--update-color-scheme',
				commandfor: popover_id,
			}
		}) }}
		{{ _self.item({
			label: 'color.dark'|trans,
			rightIcon: 'rz-icon-ri--moon-line',
			attributes: {
				type: 'button',
				'data-value': 'dark',
				command: '--update-color-scheme',
				commandfor: popover_id,
			}
		}) }}
	{% endblock %}
{% endembed %}
