{% extends '@RoadizRozier/ui/layouts/login.html.twig' %}

{% block title %}{% trans %}login{% endtrans %} | {{ parent() }}{% endblock %}

{% block login_content %}
    {% if error %}
        {% import '@RoadizRozier/ui/components/rz_message.html.twig' as rz_message %}
        <div class="rz-login__group">
            {{ rz_message.root({ color: 'error', text: error.messageKey|default(error.message)|trans(error.messageData, 'security'), attributes: { role: 'alert' } }) }}
        </div>
    {% endif %}

    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
    <div class="rz-login__group rz-login__group--row">
        {% if openid %}
            {{ rz_button.root({
                emphasis: 'secondary',
                label: openid_button_label|default('login_with_openid'),
                iconClass: 'rz-icon-ri--arrow-right-up-line',
                attributes: { href: openid },
            }) }}
        {% endif %}
        {{ rz_button.root({
            emphasis: 'secondary',
            label: 'request_login_link',
            iconClass: 'rz-icon-ri--link',
            attributes: { href: path('roadiz_rozier_login_link') },
        }) }}
    </div>
    <hr class="rz-login__divider" />
    <form id="login-form"
        class="rz-login__group"
        method="post">
        {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with {
            label: 'username',
            labelAttributes: { for: '_username' },
            required: true,
            last_username: last_username,
        } only %}
            {% block body %}
                {% import '@RoadizRozier/ui/components/rz_input.html.twig' as rz_input %}
                {{ rz_input.root({
                    type: 'text',
                    name: 'username',
                    id: '_username',
                    placeholder: 'username'|trans,
                    value: last_username,
                    required: true,
                    className: 'rz-form-field__body',
                    attributes: { autocomplete: 'username email' },
                }) }}
            {% endblock %}
        {% endembed %}
        {% set forgot_password %}
            <a href="{{ path('loginRequestPage') }}">{% trans %}forgot.password{% endtrans %}</a>
        {% endset %}
        {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with {
            label: 'password',
            labelAttributes: { for: '_password' },
            required: true,
            help: forgot_password,
        } only %}
            {% block body %}
                {% import '@RoadizRozier/ui/components/rz_input.html.twig' as rz_input %}
                {{ rz_input.root({
                    type: 'password',
                    name: 'password',
                    id: '_password',
                    placeholder: 'password'|trans,
                    required: true,
                    className: 'rz-form-field__body',
                    attributes: { autocomplete: 'current-password' },
                }) }}
            {% endblock %}
        {% endembed %}
        {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with {
            label: 'keep_me_logged_in',
            labelAttributes: { for: '_remember_me' },
        } only %}
            {% block body %}
                {% import '@RoadizRozier/ui/components/rz_switch.html.twig' as rz_switch %}
                {{ rz_switch.root({
                    id: '_remember_me',
                    name: '_remember_me',
                    checked: true,
                    className: 'rz-form-field__body',
                }) }}
            {% endblock %}
        {% endembed %}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div class="rz-login__group rz-login__group--last rz-login__group--full-width">
            {{ rz_button.root({
                emphasis: 'primary',
                label: 'login',
                iconClass: 'rz-icon-ri--arrow-right-s-line',
                attributes: { type: 'submit' },
            }) }}
        </div>
    </form>
{% endblock %}
