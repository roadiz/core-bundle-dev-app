{# rz-bulk-actions: embed vars = deleteFormAction (RzBulkActionsOptions, storybook/renderer/rzBulkActions.ts) + Twig-only deleteFormMethod, deleteFormData, deleteTitle; blocks title_content, other_actions, delete_form, delete_form_content, panels #}
{% import "@RoadizRozier/ui/components/rz_button.html.twig" as rz_button %}

<rz-bulk-actions
	class="rz-bulk-actions"
	visibility-class="rz-bulk-actions--visible"
>
	<h3 class="rz-bulk-actions__title">
		{% block title_content %}
			{% trans %}bulk.actions{% endtrans %}
		{% endblock %}
	</h3>

	<div class="rz-bulk-actions__buttons">
		{{ _self.deselect_all_button() }}

		{% block other_actions %}{% endblock %}

		{% block delete_form %}
			<form
				class="rz-bulk-actions__form-button"
				action="{{ deleteFormAction|default('') }}"
				method="{{ deleteFormMethod|default('POST') }}"
			>
				{% block delete_form_content %}
					{% if deleteFormData|default(null) %}
						{% form_theme deleteFormData '@RoadizRozier/forms.html.twig' %}
						{{ form_widget(deleteFormData) }}
					{% endif %}
				{% endblock %}
				{{
					rz_button.root({
						attributes: {
							type: 'submit',
							title: deleteTitle|default('bulk.delete'|trans),
						},
						color: 'danger',
						emphasis: 'primary',
						iconClass: 'rz-icon-ri--delete-bin-7-line',
					})
				}}
			</form>
		{% endblock %}
	</div>

	{% block panels %}{% endblock %}
</rz-bulk-actions>

{# Sub-parts take `attributes`; select_input also takes `value` (RzBulkSectionItemOptions) #}
{% macro select_all_button(options = {}) %}
    {% import "@RoadizRozier/ui/components/rz_button.html.twig" as rz_button %}
        {{
            rz_button.root({
                attributes: {
                    type: 'button',
                    'aria-selected': 'false',
                    'data-bulk-select-all-button': '',
                    'selected-class': 'rz-button--selected',
                }|merge(options.attributes|default({})),
                emphasis: 'secondary',
                label: 'select.all',
                iconClass: 'rz-icon-ri--checkbox-line'
            })
        }}
{% endmacro %}

{% macro deselect_all_button(options = {}) %}
    {% import "@RoadizRozier/ui/components/rz_button.html.twig" as rz_button %}
    {{
        rz_button.root({
            attributes: {
                type: 'button',
                title: "deselect.all"|trans,
                'data-bulk-deselect-all-button': '',
            }|merge(options.attributes|default({})),
            emphasis: 'primary',
            iconClass: 'rz-icon-ri--checkbox-blank-line',
        })
    }}
{% endmacro %}

{% macro select_all_input(options = {}) %}
    {% import "@RoadizRozier/ui/components/rz_input.html.twig" as rz_input %}
    {{ rz_input.root({
        type: 'checkbox',
        name: 'bulk-selection-all',
        attributes: { 'aria-label': 'select.all'|trans }|merge(options.attributes|default({})),
    }) }}
{% endmacro %}

{% macro select_input(options = {}) %}
    {% import "@RoadizRozier/ui/components/rz_input.html.twig" as rz_input %}
    {{ rz_input.root({
        type: 'checkbox',
        name: 'bulk-selection[]',
        value: options.value ?? null,
        attributes: { 'aria-label': 'select.row'|trans }|merge(options.attributes|default({})),
    }) }}
{% endmacro %}
