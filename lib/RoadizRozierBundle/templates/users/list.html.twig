{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{% trans %}users{% endtrans %} | {{ parent() }}{% endblock %}

{% block content %}
    <rz-bulk-section>
        {% include '@RoadizRozier/users/head.html.twig' with {
            title: 'users'|trans,
            filters: filters,
            buttons: [{
                label: 'add.a.user'|trans,
                attributes: {
                    href: path('usersAddPage'),
                },
                iconClass: 'rz-icon-ri--add-line',
            }],
        } only %}

        {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
            filters: filters,
            displaySelectAllButton: false,
        }  only %}{% endembed %}

        {% include '@RoadizRozier/users/bulkActions.html.twig' with {
            deleteFormData: bulkDeleteForm|default(null),
            deleteFormAction: path('usersBulkDeletePage'),
            deleteFormMethod: 'GET',
            bulkEnableForm: bulkEnableForm,
            bulkDisableForm: bulkDisableForm,
        } only %}
        <article>
            {% include '@RoadizRozier/users/list_table.html.twig' with {
                selectionAvailable: hasBulkActions,
                actionsAvailable: true,
            } %}
        </article>
    </rz-bulk-section>
{% endblock %}
