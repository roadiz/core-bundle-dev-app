{% extends "@RoadizRozier/documents/list.html.twig" %}

{% block content_body %}
    <article>
        {% block pre_content_body %}{% endblock %}

        {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
            selectionAvailable: true,
            actionsAvailable: true,
        } %}
            {% block thead_cells %}
                {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
                <th class="mobile-hidden"></th>
                <th>
                    {% if not no_sorting %}
                        {{ rz_table.column_ordering({
                            field: 'filename',
                            label: 'document.filename'|trans,
                            filters: filters|default(null),
                        }) }}
                    {% endif %}
                </th>
                <th class="mobile-hidden">
                    {% if not no_sorting %}
                        {{ rz_table.column_ordering({
                            field: 'createdAt',
                            label: 'document.createdAt'|trans,
                            filters: filters|default(null),
                        }) }}
                    {% endif %}
                </th>
                <th class="mobile-hidden">
                    {% if not no_sorting %}
                        {{ rz_table.column_ordering({
                            field: 'mimeType',
                            label: 'document.mimeType'|trans,
                            filters: filters|default(null),
                        }) }}
                    {% endif %}
                </th>
                <th>
                    {% if not no_sorting %}
                        {{ rz_table.column_ordering({
                            field: 'filesize',
                            label: 'document.filesize'|trans,
                            filters: filters|default(null),
                        }) }}
                    {% endif %}
                </th>
                <th class="mobile-hidden rz-table__cell--from-lg">
                    {% if not no_sorting %}
                        {{ rz_table.column_ordering({
                            field: 'imageWidth',
                            label: 'document.width'|trans,
                            filters: filters|default(null),
                        }) }}
                    {% endif %}
                </th>
                <th class="mobile-hidden rz-table__cell--from-lg">
                    {% if not no_sorting %}
                        {{ rz_table.column_ordering({
                            field: 'imageHeight',
                            filters: filters,
                            label: 'document.height'|trans
                        }) }}
                    {% endif %}
                </th>
                <th class="mobile-hidden rz-table__cell--from-lg"></th>
            {% endblock %}

            {% block tbody_content %}
                {% import '@RoadizRozier/ui/components/rz_badge.html.twig' as rz_badge %}
                {% for document in documents %}
                    <tr
                     {{ _self.colored_row_attrs({'color': document.imageAverageColor }) }}
                    >
                        {% if selectionAvailable %}
                        <td>
					        {% import '@RoadizRozier/ui/components/rz_bulk_actions.html.twig' as rz_bulk_actions %}
                            {{ rz_bulk_actions.select_input({ value: document.id }) }}
                        </td>
                        {% endif %}
                        <td class="mobile-hidden rz-table__cell rz-table__cell--flex-center">
                            {% if not document.private and (document.isImage or document.isSvg or document.hasThumbnails) %}
                                {{ document|display({
                                    align: document.imageCropAlignment,
                                    hotspot: document.hotspotAsString,
                                    width: 54,
                                    crop: '1:1',
                                    quality: 70,
                                    class: 'rz-entity-thumbnail'
                                }) }}
                            {% endif %}
                            {% if not (document.isImage or document.isSvg) and document.shortType != 'unknown' %}
                                {{ rz_badge.root({
                                    iconClass: 'rz-icon-ri--file-' ~ document.shortType ~ '-line',
                                    size: 'md',
                                })}}
                            {% endif %}
                        </td>
                        <td>
                            {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
                            {{ rz_link.root({
                                label: document|centralTruncate(30, -4),
                                attributes: { href: path('documentsEditPage', { documentId: document.id }) },
                            }) }}
                        </td>
                        <td class="mobile-hidden">
                            {{ document.createdAt|format_datetime('short', 'short') }}
                        </td>
                        <td class="mobile-hidden">{{ document.mimeType }}</td>
                        <td>
                            {% if document.filesize > 0 %}
                                {{ document.filesize|formatBytes }}
                            {% endif %}
                            {% if document.rawDocument and document.rawDocument.filesize > 0  %}
                                <br>
                                <span class="rz-icon-ri--camera-line" title="{{ 'original.document'|trans }}"></span>
                                {{ document.rawDocument.filesize|formatBytes }}
                            {% endif %}
                        </td>
                        <td class="mobile-hidden rz-table__cell--from-lg">{% if document.imageWidth > 0 %}{{ document.imageWidth }}px{% endif %}</td>
                        <td class="mobile-hidden rz-table__cell--from-lg">{% if document.imageHeight > 0 %}{{ document.imageHeight }}px{% endif %}</td>
                        <td class="mobile-hidden rz-table__cell--from-lg">
                            {% if document.embedPlatform %}
                                {% set iconName = (document|embedFinder).shortType %}
                                {% if document.embedPlatform == 'unsplash' or document.embedPlatform == 'splashbase' %}
                                    {% set iconName = 'documents' %}
                                {% endif %}
                                {% import "@RoadizRozier/ui/components/rz_badge.html.twig" as rz_badge %}
                                {{ rz_badge.root({
                                    label: iconName,
                                    iconClass: 'rz-icon-logo--' ~ iconName,
                                    attributes: {
                                        title: document.embedPlatform|trans|capitalize,
                                    }
                                }) }}
                            {% endif %}
                        </td>
                        <td>
                            {% include '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                                'editHref': path('documentsEditPage', { documentId: document.id }),
                                'deleteHref': path('documentsDeletePage', { documentId: document.id }),
                            } %}
                        </td>
                    </tr>
                {% else %}
                    <tr class ><td class="rz-message__text" colspan="10">{% trans %}no_document{% endtrans %}</td></tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    </article>
{% endblock %}
