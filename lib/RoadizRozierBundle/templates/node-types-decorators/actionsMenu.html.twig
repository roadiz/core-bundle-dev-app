{% embed "@RoadizRozier/ui/components/rz_actions_menu.html.twig" with {
    vertical: true,
    class: 'actions-menu',
    item: item
} only %}
    {% block items %}
        {% if is_granted('ROLE_ACCESS_NODETYPES') and item.id %}
            {{ _self.deleteItem({ attributes: { href: path('nodeTypeDecoratorsDeletePage', { id: item.id}) } }) }}
        {% endif %}
    {% endblock %}
{% endembed %}
