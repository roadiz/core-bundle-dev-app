{% extends '@RoadizRozier/layout.html.twig' %}

{%- block title -%}
    {% trans %}manage.redirections{% endtrans %}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
    <rz-bulk-section>
        {% include '@RoadizRozier/redirections/head.html.twig' with {
            title: 'manage.redirections'|trans,
            filters: filters,
            buttons: [{
                label: 'add.a.redirection'|trans,
                attributes: {
                    href: path('redirectionsAddPage'),
                },
                iconClass: 'rz-icon-ri--add-line'
            }],
        } only %}

        {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
            filters: filters,
            displaySelectAllButton: true,
        }  only %}{% endembed %}

        {% include '@RoadizRozier/ui/patterns/bulk_actions.html.twig' %}

        <article>
            {% include '@RoadizRozier/redirections/list_table.html.twig' with {
                items: items,
                filters: filters,
                actionsAvailable: true,
                selectionAvailable: hasBulkActions,
            } only %}
        </article>

    </rz-bulk-section>
{% endblock %}
