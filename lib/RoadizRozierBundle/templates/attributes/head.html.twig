{# Simple scope - uses generic head template #}
{# A caller that already composed its own trail (confirm_action) keeps it. #}
{% if breadcrumb is not defined or not breadcrumb %}
    {% set root = breadcrumb_root('attributes') %}
    {% set breadcrumb = {
        parents: app.request.attributes.get('_route') == root.route
            ? []
            : [root]|merge(breadcrumb_parents|default([])),
        current: title,
    } %}
{% endif %}

{% include "@RoadizRozier/admin/head.html.twig" with {
    title: title,
    buttons: buttons,
    filters: filters,
    with_nav_bar: with_nav_bar,
    nav_bar_template: nav_bar_template,
    nav_bar_context: nav_bar_context,
    breadcrumb: breadcrumb,
} only %}
