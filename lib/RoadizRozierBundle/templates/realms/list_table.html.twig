{% embed '@RoadizRozier/ui/components/rz_table.html.twig' %}
    {% block thead_cells %}
        {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
        <th>
            {{ rz_table.column_ordering({
                field: 'name',
                filters: filters,
                label: 'name'|trans,
            }) }}
        </th>
        <th>
            {{ rz_table.column_ordering({
                field: 'type',
                filters: filters,
                label: 'realm.type'|trans,
            }) }}
        </th>
        <th>
            {{ rz_table.column_ordering({
                field: 'behaviour',
                filters: filters,
                label: 'realm.behaviour'|trans,
            }) }}
        </th>
        <th>
            {% trans %}realm.serializationGroup{% endtrans %}
        </th>
    {% endblock %}

    {% block tbody_content %}
        {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
        {% for item in items %}
            <tr>
                <td>
                    {{ rz_link.root({
                        label: item.name,
                        attributes: { href: path('realmsEditPage', { id: item.id }) },
                    }) }}
                </td>
                <td>{{ ('realm.' ~ item.type)|trans }}</td>
                <td>{{ ('realm.behaviour_' ~ item.behaviour)|trans }}</td>
                <td>{{ item.serializationGroup }}</td>
                {% if actionsAvailable %}
                    <td>
                        {% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                            'editHref': path('realmsEditPage', { id: item.id }),
                            'deleteHref': path('realmsDeletePage', { id: item.id }),
                        } %}
                    {% endembed %}
                    </td>
                {% endif %}
            </tr>
        {% else %}
            {{ _self.fallback_row({
                length: 4,
                selectionAvailable: selectionAvailable,
                actionsAvailable: actionsAvailable,
                message: 'no_realms',
            }) }}
        {% endfor %}
    {% endblock %}
{% endembed %}
