{#
 # Public custom form widgets, layered on top of the Rozier form theme:
 # {% form_theme form '@RoadizRozier/forms.html.twig' '@RoadizCore/customForm/customForms.html.twig' %}
 # Only the captcha widgets live here, every other field renders like in the backoffice.
 #}
{% block recaptcha_widget -%}
    <input id="add-custom-form-form-recaptcha" type="hidden" name="{{ form.vars.name }}" />
    <script src="https://www.google.com/recaptcha/api.js?render={{ configs.publicKey }}"></script>
    <script>
        /*
         * Google Recaptcha v3
         * @see https://developers.google.com/recaptcha/docs/v3
         */
        (function() {
            if (!window.grecaptcha) {
                console.warn('Recaptcha is not loaded');
            }
            var form = document.getElementById('add-custom-form-form');
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                window.grecaptcha.ready(function() {
                    window.grecaptcha.execute('{{ configs.publicKey }}', {action: 'submit'}).then(function(token) {
                        var input = document.getElementById('add-custom-form-form-recaptcha');
                        if (input) {
                            input.value = token;
                        }
                        form.submit()
                    });
                });
            });
        })();
    </script>
{%- endblock recaptcha_widget %}

{% block friendlycaptcha_widget -%}
    {# FriendlyCaptcha widget frc-captcha-response #}
    {# https://developer.friendlycaptcha.com/docs/v2/getting-started/verify #}
    <script type="module" src="https://cdn.jsdelivr.net/npm/@friendlycaptcha/sdk@0.1.26/site.min.js" async defer></script>
    <script nomodule src="https://cdn.jsdelivr.net/npm/@friendlycaptcha/sdk@0.1.26/site.compat.min.js" async defer></script>
    <div class="frc-captcha" id="{{ form.vars.id }}" data-sitekey="{{ configs.publicKey }}" data-form-field-name="{{ form.vars.full_name }}"></div>
{%- endblock friendlycaptcha_widget %}

{% block hcaptcha_widget -%}
    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
    <div class="h-captcha" id="{{ form.vars.id }}" data-sitekey="{{ configs.publicKey }}" data-form-field-name="{{ form.vars.full_name }}"></div>
{%- endblock hcaptcha_widget %}

{% block cf_turnstile_widget -%}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <div
        class="cf-turnstile"
        id="{{ form.vars.id }}"
        data-sitekey="{{ configs.publicKey }}"
        data-form-field-name="{{ form.vars.full_name }}"
        data-callback="javascriptCallback"
    ></div>
{%- endblock cf_turnstile_widget %}

{% block cap_widget -%}
    {# Cap (https://trycap.dev) self-hosted captcha. Endpoint is derived from verify_url. #}
    <script type="module" src="https://cdn.jsdelivr.net/npm/cap-widget@0.1.57" async defer></script>
    <cap-widget
        id="{{ form.vars.id }}"
        data-cap-api-endpoint="{{ configs.publicKey }}"
        data-cap-hidden-field-name="{{ form.vars.full_name }}"
    ></cap-widget>
{%- endblock cap_widget %}
