{# A caller that already composed its own trail (confirm_action) keeps it. #}
{% if breadcrumb is not defined or not breadcrumb %}
    {% set folder = folder is defined and folder ? folder : null %}
    {# Documents live under a folder tree: inside one, the trail roots on folders instead. #}
    {% set root = breadcrumb_root(folder ? 'folders' : 'documents') %}
    {% set breadcrumb = {
        parents: app.request.attributes.get('_route') == root.route
            ? []
            : [root]|merge(folder ? folder.getParents : breadcrumb_parents|default([])),
        current: folder ? folder.name|default(folder.folderName) : title,
    } %}
{% endif %}

{% embed "@RoadizRozier/ui/components/rz_page_header.html.twig" with {
    breadcrumb: breadcrumb,
} %}
    {% block translation %}
        {% if available_translations is defined and available_translations and translation is defined and translation.id %}
            <div class="rz-page-header__item--right">
                {{ _self.translations_bar({
                    availableTranslations: available_translations,
                    current: translation.id,
                    path: 'documentsMetaPage',
                    pathParams: {
                        documentId: document.id,
                    },
                }) }}
            </div>
        {% endif %}
    {% endblock %}


    {% block buttons %}
        {% if not displayPrivateDocuments and displayButtonAction %}
            <div class="rz-button-group--gap-md rz-page-header__item--right">
                {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
                {{ rz_button.root({
                    emphasis: 'primary',
                    label: 'upload.document',
                    iconClass: 'rz-icon-ri--upload-line',
                    attributes: {
                        class: 'rz-button-group__button',
                        href: path('documentsUploadPage', { folderId: folder.id }),
                    },
                }) }}
                {{ rz_button.root({
                    emphasis: 'primary',
                    label: 'embed.document',
                    iconClass: 'rz-icon-ri--add-line',
                    attributes: {
                        class: 'rz-button-group__button',
                        href: path('documentsEmbedPage', { folderId: folder.id }),
                    },
                }) }}
                {# Random document: feature not working, link to documentsRandomPage removed until it is fixed #}
            </div>
        {% endif %}
    {% endblock %}

    {% block badges %}
        {% if filters and filters.itemCount %}
            {% import "@RoadizRozier/ui/components/rz_badge.html.twig" as rz_badge %}
            <div class="rz-page-header__item">
                {{ rz_badge.root({
                    label: '%count%.items'|transchoice(filters.itemCount)|raw,
                    size: 'sm',
                }) }}
            </div>
        {% endif %}
    {% endblock %}

    {% block title %}
        <h1 class="rz-page-header__title rz-page-header__item">
            {{ title }}
        </h1>
    {% endblock %}

    {% block nav_bar %}
        {% if with_nav_bar is defined and with_nav_bar %}
            {% if folder is defined and folder %}
                {% include '@RoadizRozier/folders/navBar.html.twig' with {folder: folder, current: current, translation: translation} %}
            {% else %}
                {% include '@RoadizRozier/documents/navBar.html.twig' with {current: current} %}
            {% endif %}
        {% endif %}
    {% endblock %}
{% endembed %}
