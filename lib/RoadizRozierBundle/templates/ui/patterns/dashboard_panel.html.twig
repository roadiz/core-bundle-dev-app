{% macro header(icon, title, button) %}
	<div class="rz-dashboard__panel__header">
		{% if icon %}
			<span class="{{ icon }}"></span>
		{% endif %}

		{% if title %}
			<h3 class="rz-dashboard__panel__title">{{ title }}</h3>
		{% endif %}

		{% if button %}
		    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
			{{ rz_button.root(button|merge({ attributes: button.attributes|default({})|merge({ class: html_classes('rz-dashboard__header__button', button.attributes.class|default('')) }) })) }}
		{% endif %}
	</div>
{% endmacro %}

{% set type_class = 'rz-dashboard__panel--' ~ type|default('default') %}

<div
	class="rz-dashboard__panel {{ type_class }}"
	{% if id %}id="{{ id }}"{% endif %}
>
	{% block header %}
		{{ _self.header(icon, title, button) }}
	{% endblock %}

	{% block content %}{% endblock %}
</div>
