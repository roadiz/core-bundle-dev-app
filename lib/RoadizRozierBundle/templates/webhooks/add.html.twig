{% extends '@RoadizRozier/layout.html.twig' %}
{% set title = "add.a.webhook"|trans %}

{% block title %}{{ title }} | {{ parent() }}{% endblock %}

{% block content %}
<section class="content-global add-item">
    {% include '@RoadizRozier/ui/patterns/page_header.html.twig' with {
        title: title,
        breadcrumb: {
            parents: [breadcrumb_root('webhooks')],
            current: title,
        },
    } only %}

    <article class="content content-add">
        {% form_theme form '@RoadizRozier/forms.html.twig' %}
        {{ form_start(form, { attr: { id: "add-webhook-form" }}) }}
            {{ form_widget(form) }}
            {% import "@RoadizRozier/ui/components/rz_actions_menu.html.twig" as actions_menu %}
            {{ actions_menu.saveItem({ dataActionSave: '#add-webhook-form' }) }}
        {{ form_end(form) }}
    </article>

    {% include '@RoadizRozier/webhooks/actionsMenu.html.twig' with {"item": item} only %}
</section>
{% endblock %}
