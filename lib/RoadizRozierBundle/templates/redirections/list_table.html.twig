{% embed '@RoadizRozier/ui/components/rz_table.html.twig' %}
    {% block thead_cells %}
        {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
        <th>
            {% set label = 'redirection.query'|trans %}
            {% if not no_sort %}
            {{ rz_table.column_ordering({
                field: 'query',
                filters: filters,
                label: label,
            }) }}
            {% else %}
                {{ label }}
            {% endif %}
        </th>
        <th>
            {% set label = 'redirection.redirect_uri'|trans %}
            {% if not no_sort %}
            {{ rz_table.column_ordering({
                field: 'redirectUri',
                filters: filters,
                label: label,
            }) }}
            {% else %}
                {{ label }}
            {% endif %}
        </th>
        <th class="mobile-hidden">{% trans %}redirection.type{% endtrans %}</th>
        <th class="mobile-hidden">
            {% set label = 'redirection.use_count'|trans %}
            {% if not no_sort %}
                {{ rz_table.column_ordering({
                    field: 'useCount',
                    filters: filters,
                    label: label,
                }) }}
            {% else %}
                {{ label }}
            {% endif %}
        </th>
    {% endblock %}

    {% block tbody_content %}
        {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
        {% for item in items %}
            <tr>
                {% set url = path('redirectionsEditPage', { id: item.id }) %}
                {% if item.redirectNodeSource %}
                    {% set url = path('nodesEditSEOPage', {
                        'nodeId': item.redirectNodeSource.node.id,
                        'translationId': item.redirectNodeSource.translation.id
                    }) ~ '#manage-redirections' %}
                {% endif %}
                {% if selectionAvailable %}
                    <td>
                        {% import '@RoadizRozier/ui/components/rz_bulk_actions.html.twig' as rz_bulk_actions %}
                        {{ rz_bulk_actions.select_input({ value: item.id }) }}
                    </td>
                {% endif %}
                <td>
                    {{ rz_link.root({
                        label: item.query,
                        attributes: { href: url },
                    }) }}
                </td>
                <td>
                    {% if item.redirectNodeSource %}
                        <i class="uk-icon uk-icon-magic"></i>
                        {{ path(item.redirectNodeSource) -}}
                    {% else %}
                        {{- item.redirectUri|u.truncate(80, '…') -}}
                    {% endif %}
                </td>
                <td class="mobile-hidden">{{ item.typeAsString|trans }}</td>
                <td class="mobile-hidden">{{ item.useCount }}</td>
                {% if actionsAvailable %}
                    <td>
                        {% include '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                            'editHref': url,
                            'deleteHref':path('redirectionsDeletePage', { id: item.id }),
                        } %}
                    </td>
                {% endif %}
            </tr>
        {% else %}
            {{ _self.fallback_row({
                length: 4,
                selectionAvailable: selectionAvailable,
                actionsAvailable: actionsAvailable,
                message: 'no_redirections',
            }) }}
        {% endfor %}
    {% endblock %}
{% endembed %}
