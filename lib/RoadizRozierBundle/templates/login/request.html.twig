{% extends '@RoadizRozier/ui/layouts/login.html.twig' %}

{% block login_content %}
    {% if not error and form.vars.valid %}
    <p class="text-body-md rz-login__group">{% trans %}to.get.new.password.enter.your.account.email{% endtrans %}</p>
    {% endif %}

    {% if error %}
    <div class="uk-alert uk-alert-danger">{{ error }}</div>
    {% endif %}

    {% form_theme form '@RoadizRozier/forms.html.twig' %}
    <form id="login-form"
              class="rz-login__group"
              method="post">
        {{ form_widget(form) }}
        <div class="rz-login__group rz-login__group--last rz-login__group--full-width">
            {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
            {{ rz_button.root({
                emphasis: 'primary',
                label: 'request.new.password',
                iconClass: 'rz-icon-ri--arrow-right-s-line',
                attributes: { type: 'submit' },
            }) }}
        </div>
    </form>
{% endblock %}
