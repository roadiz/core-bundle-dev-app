{% extends '@RoadizRozier/ui/layouts/login.html.twig' %}

{% block title %}{% trans %}login_link{% endtrans %} | {{ parent() }}{% endblock %}

{% block login_content %}
    <form id="login-form"
          action="{{ path('roadiz_rozier_login_link') }}"
          class="rz-login__group"
          method="post">
        {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with {
            label: 'email',
            labelAttributes: { for: 'email' },
            required: true,
        } only %}
            {% block body %}
                {% import '@RoadizRozier/ui/components/rz_input.html.twig' as rz_input %}
                {{ rz_input.root({
                    type: 'email',
                    name: 'email',
                    id: 'email',
                    placeholder: 'email'|trans,
                    required: true,
                    className: 'rz-form-field__body',
                    attributes: { autocomplete: 'email', autofocus: true },
                }) }}
            {% endblock %}
        {% endembed %}
        {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
        <div class="rz-login__group rz-login__group--last rz-login__group--full-width">
            {{ rz_button.root({
                emphasis: 'secondary',
                label: 'classic.login_password',
                iconClass: 'rz-icon-ri--lock-password-line',
                attributes: { href: path('loginPage') },
            }) }}
            {{ rz_button.root({
                emphasis: 'primary',
                label: 'request_login_link',
                iconClass: 'rz-icon-ri--arrow-right-s-line',
                attributes: { type: 'submit' },
            }) }}
        </div>
    </form>
{% endblock %}
