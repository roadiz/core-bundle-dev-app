{% extends '@RoadizRozier/layout.html.twig' %}
{% import "@RoadizRozier/macros/rz_button.html.twig" as rz_button %}

{% block title %}{% trans %}two_factor_backup_codes{% endtrans %} | {{ parent() }}{% endblock %}

{% block content %}
    <section class="rz-page__body">
        {% include '@RoadizRozier/admin/head.html.twig' with {
            title: 'two_factor_backup_codes'|trans,
            breadcrumb: {
                label: 'two-factor-breadcrumb',
                current: 'two_factor_backup_codes'|trans,
            }
        } only %}

        <article class="content content-delete content-no-action-menu">
            {% if backupCodes %}
                <div class="rz-message rz-form-field__message">
                    <p class="rz-message__text">
                        {% trans %}store_your_backup_codes{% endtrans %}
                    </p>
                </div>
                <ul>
                    {% for code in backupCodes %}
                        <li><code>{{ code }}</code></li>
                    {% endfor %}
                </ul>
                <div class="rz-button-group rz-button-group--gap-md">
                    {{
                        rz_button.root({
                            tagName: 'a',
                            attributes: {
                                href: path('2fa_admin_two_factor'),
                            },
                            emphasis: 'secondary',
                            label: 'back_to.two_factor',
                            icon: 'rz-icon-ri--corner-down-left-line',
                        })
                    }}
                </div>
            {% elseif form %}
                {% form_theme form '@RoadizRozier/forms.html.twig' %}
                {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="rz-message rz-message--warning rz-form-field__message">
                    <p class="rz-message__text">
                        {% trans %}are_you_sure.generate.two_factor_backup_codes.erasing_any_existing{% endtrans %}
                    </p>
                </div>
                <div class="rz-button-group rz-button-group--gap-md">
                    {{
                        rz_button.root({
                            tagName: 'a',
                            attributes: {
                                href: path('2fa_admin_two_factor'),
                            },
                            emphasis: 'secondary',
                            label: 'cancel',
                            icon: 'rz-icon-ri--corner-down-left-line',
                        })
                    }}
                    {{
                        rz_button.root({
                            attributes: {
                                type: 'submit',
                            },
                            emphasis: 'primary',
                            color: 'danger',
                            label: 'generate_backup_codes',
                            icon: 'rz-icon-ri--refresh-line',
                        })
                    }}
                </div>
                {{ form_end(form) }}
            {% endif %}
        </article>
    </section>
{% endblock %}
