{% extends '@RoadizRozier/layout.html.twig' %}

{%- block title -%}
    {% trans %}translations{% endtrans %}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
    {% include '@RoadizRozier/translations/head.html.twig' with {
        title: 'translations'|trans,
        filters: filters,
        buttons: [{
            label: 'add.a.translation'|trans,
            attributes: {
                href: path('translationsAddPage'),
            },
            iconClass: 'rz-icon-ri--add-line'
        }],
    } only %}

    {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
        filters: filters,
        displaySelectAllButton: false,
    }  only %}{% endembed %}

    <section class="rz-page__body">
        {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
            selectionAvailable: hasBulkActions,
            actionsAvailable: true,
        } %}

            {% block thead_cells %}
                {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
                <th>
                    {{ rz_table.column_ordering({
                        field: 'name',
                        filters: filters,
                        label: 'name'|trans,
                    }) }}
                </th>
                <th>
                    {{ rz_table.column_ordering({
                        field: 'locale',
                        filters: filters,
                        label: 'translation.locale'|trans,
                    }) }}
                </th>
                <th>
                    {{ rz_table.column_ordering({
                        field: 'overrideLocale',
                        filters: filters,
                        label: 'overrideLocale'|trans,
                    }) }}
                </th>
                <th>{% trans %}status{% endtrans %}</th>
            {% endblock %}

            {% block tbody_content %}
                {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
                {% import '@RoadizRozier/ui/components/rz_badge.html.twig' as rz_badge %}

                {% for t in translations %}
                    <tr>
                        <td>
                            {{ rz_link.root({
                                label: t.translation.getName,
                                attributes: { href: path('translationsEditPage', { translationId: t.translation.getId }) },
                            }) }}
                        </td>
                        <td>{{ t.translation.locale }}</td>
                        <td>{{ t.translation.overrideLocale }}</td>
                        <td>
                            {% if t.translation.isAvailable == false %}
                                {{ rz_badge.root({ label: 'not_available'|trans })}}
                            {% endif %}
                            {% if t.translation.isDefaultTranslation == true %}
                                {{ rz_badge.root({
                                    iconClass: 'rz-icon-ri--star-line',
                                    attributes: {
                                        'title': 'default.translation'|trans
                                    }
                                    }) }}
                            {% endif %}
                        </td>
                        {% if actionsAvailable %}
                            {% set is_not_default = t.translation.isDefaultTranslation == false %}
                            <td>
                                {% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                                    'editHref': path('translationsEditPage', { translationId: t.translation.getId }),
                                    'deleteHref': is_not_default ? path('translationsDeletePage', { translationId: t.translation.getId }) : null,
                                } %}
                                    {% block other_actions %}
                                        {% if is_not_default is same as(true) %}
                                            {% form_theme t.defaultForm '@RoadizRozier/forms.html.twig' %}
                                            <form class="rz-form" action="#" method="post">
                                                {{ form_widget(t.defaultForm, { attr: { style: 'display: none;' }}) }}
                                                {{ _self.button({
                                                    iconClass: 'rz-icon-ri--star-line',
                                                    attributes: {
                                                        type: 'submit',
                                                        title: 'set.default'|trans,
                                                    }
                                                }) }}
                                            </form>
                                        {% endif %}
                                    {% endblock %}
                                {% endembed %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    </section>
{% endblock %}
