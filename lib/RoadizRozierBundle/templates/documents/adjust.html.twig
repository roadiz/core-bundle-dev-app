{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{{ "edit.document.%name%"|trans({'%name%': document})|truncate_title }} | {{ parent() }}{% endblock %}

{% macro tool(action, title, icon, shortcut) %}
    <button type="button"
            class="rz-button"
            data-action="{{ action }}"
            title="{{ title|trans }} ({{ shortcut }})"
            aria-label="{{ title|trans }}"
            data-state="editing">
        <span class="rz-button__icon {{ icon }}" aria-hidden="true"></span>
    </button>
{% endmacro %}

{% block content %}
    <section class="content-global manage-document">
        {% include '@RoadizRozier/documents/head.html.twig' with {
            document: document,
            title: "edit.document.%name%"|trans({'%name%': document})|truncate_title,
            current: 'adjust',
            with_nav_bar: true,
        } only %}

        <article class="content content-document-edit">
            {% if document and document.image %}
                <rz-image-editor class="rz-image-editor"
                                 filename="{{ document.filename }}"
                                 mime-type="{{ document.mimeType }}">
                    <div class="rz-image-editor__toolbar rz-button-group">
                        {{ _self.tool('drag-move', 'blanchetteEditor.move', 'rz-icon-ri--drag-move-2-line', 'M') }}
                        {{ _self.tool('drag-crop', 'blanchetteEditor.crop', 'rz-icon-ri--crop-line', 'C') }}
                        {{ _self.tool('zoom-in', 'blanchetteEditor.zoomIn', 'rz-icon-ri--zoom-in-line', 'I') }}
                        {{ _self.tool('zoom-out', 'blanchetteEditor.zoomOut', 'rz-icon-ri--zoom-out-line', 'O') }}
                        {{ _self.tool('rotate-left', 'blanchetteEditor.rotateLeft', 'rz-icon-ri--loop-left-line', 'L') }}
                        {{ _self.tool('rotate-right', 'blanchetteEditor.rotateRight', 'rz-icon-ri--loop-right-line', 'R') }}
                        {{ _self.tool('flip-horizontal', 'blanchetteEditor.flipHorizontal', 'rz-icon-ri--flip-horizontal-2-line', 'H') }}
                        {{ _self.tool('flip-vertical', 'blanchetteEditor.flipVertical', 'rz-icon-ri--flip-vertical-2-line', 'V') }}

                        <select class="rz-select rz-image-editor__select"
                                data-aspect-ratio
                                data-state="editing"
                                title="{{ 'blanchetteEditor.aspectRatio'|trans }}"
                                aria-label="{{ 'blanchetteEditor.aspectRatio'|trans }}">
                            <optgroup label="{{ 'blanchetteEditor.other'|trans }}">
                                <option value="free">{{ 'blanchetteEditor.free'|trans }}</option>
                                <option value="1:1">1:1</option>
                                <option value="4:3">4:3</option>
                            </optgroup>
                            <optgroup label="{{ 'blanchetteEditor.landscape'|trans }}">
                                <option value="16:9">16:9</option>
                                <option value="21:9">21:9</option>
                            </optgroup>
                            <optgroup label="{{ 'blanchetteEditor.portrait'|trans }}">
                                <option value="9:16">9:16</option>
                                <option value="9:21">9:21</option>
                            </optgroup>
                        </select>

                        <button type="button" class="rz-button" data-action="crop" data-state="editing">
                            <span class="rz-button__label">{{ 'blanchetteEditor.applyChange'|trans }}</span>
                            <span class="rz-button__icon rz-icon-ri--check-line" aria-hidden="true"></span>
                        </button>

                        <button type="button" class="rz-button" data-action="undo" data-state="cropped" hidden>
                            <span class="rz-button__label">{{ 'blanchetteEditor.undo'|trans }}</span>
                            <span class="rz-button__icon rz-icon-ri--arrow-go-back-line" aria-hidden="true"></span>
                        </button>
                        <button type="button" class="rz-button" data-action="overwrite" data-state="cropped" hidden>
                            <span class="rz-button__label">{{ 'blanchetteEditor.saveAndOverwrite'|trans }}</span>
                            <span class="rz-button__icon rz-icon-ri--save-line" aria-hidden="true"></span>
                        </button>
                    </div>

                    <div class="rz-image-editor__canvas">
                        <div class="rz-image-editor__loader" data-loader hidden>
                            <span class="rz-spinner rz-spinner--lg"></span>
                        </div>
                        <img class="rz-image-editor__image"
                             data-image
                             src="{{ document|url({ 'noProcess': true }) }}"
                             alt=""
                             {% if document.imageWidth %}width="{{ document.imageWidth }}"{% endif %}
                             {% if document.imageHeight %}height="{{ document.imageHeight }}"{% endif %}>
                    </div>

                    <div hidden>
                        {{ form(file_form) }}
                    </div>
                </rz-image-editor>
            {% endif %}
        </article>
    </section>
{% endblock %}
