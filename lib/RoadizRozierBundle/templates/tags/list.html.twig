{% extends '@RoadizRozier/layout.html.twig' %}

{%- block title -%}
    {% trans %}tags{% endtrans %}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
<rz-bulk-section>
    {% include '@RoadizRozier/tags/head.html.twig' with {
        title: 'tags'|trans,
        filters: filters,
        buttons: [{
            label: 'add.a.tag'|trans,
            attributes: {
                href: path('tagsAddPage'),
            },
            iconClass: 'rz-icon-ri--add-line',
        }],
    } only %}

    {% include '@RoadizRozier/tags/filtersBar.html.twig' with {
        filters: filters,
    } only %}

    {% embed "@RoadizRozier/ui/components/rz_bulk_actions.html.twig" with {
        deleteFormData: deleteTagsForm,
        deleteFormAction: path('tagsBulkDeletePage'),
        deleteFormMethod: 'GET',
    } only %}{% endembed %}

    <section class="rz-page__body">
        {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
            sortable: false,
            selectionAvailable: true,
            actionsAvailable: true,
        } %}

            {% block thead_cells %}
                {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
                <th>
                    {{ rz_table.column_ordering({
                        field: 'tagName',
                        filters: filters,
                        label: 'name'|trans
                    }) }}
                </th>
                <th>{% trans %}id{% endtrans %}</th>
            {% endblock %}

            {% block tbody_content %}
                {% import '@RoadizRozier/ui/components/rz_badge.html.twig' as rz_badge %}
                {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}

                {% for tag in tags %}
                    {% set translated_tag = tag.getTranslatedTags.first %}
                    {% set edit_link = translated_tag ?
                        path('tagsEditTranslatedPage', { tagId: tag.id, translationId: translated_tag.translation.id })
                        : path('tagsEditPage', { tagId: tag.id })
                    %}
                    {% set can_delete = is_granted('ROLE_ACCESS_TAGS_DELETE') and not tag.locked %}
                    <tr
                        {{ _self.colored_row_attrs({'color': tag.color }) }}
                    >
                        {{ _self.selection_input({ selectionAvailable: selectionAvailable, value: tag.id, disabled: not can_delete }) }}
                        <td>
                            {{ rz_link.root({
                                label: translated_tag.getName|default('tag_' ~ tag.id),
                                attributes: { href: edit_link },
                            }) }}
                            {% if not translated_tag %}
                                {{ rz_badge.root({
                                    iconClass: 'rz-icon-ri--error-warning-line',
                                    color: 'warning',
                                    attributes: {
                                        title: 'notranslation_available.tag'|trans,
                                    }
                                }) }}
                            {% endif %}
                        </td>
                        <td>{{ tag.id }}</td>
                        {% if actionsAvailable %}
                            <td>
                                {% include '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                                    'editHref': edit_link,
                                    'deleteHref': can_delete ? path('tagsDeletePage', { tagId: tag.id }) : null,
                                } only %}
                            </td>
                        {% endif %}
                    </tr>
                {% else %}
                    {{ _self.fallback_row({
                        length: 2,
                        selectionAvailable: selectionAvailable,
                        actionsAvailable: actionsAvailable,
                        message: 'no_tags',
                    }) }}
                {% endfor %}
            {% endblock %}
        {% endembed %}
    </section>

</rz-bulk-section>
{% endblock %}
