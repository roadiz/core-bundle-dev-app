meta {
  name: Custom form field - Update position
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/rz-admin/ajax/custom-forms/fields/edit/position
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  csrfToken: {{ajaxToken}}
  id: 1
  ~prevId: 2
  ~nextId: 3
  ~firstPosition: true
  ~lastPosition: true
}
