
{% set currentTitle = node.nodeSources.first.title|default(node.nodeName) %}

{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{{ "edit.node.%name%"|trans({'%name%': currentTitle})|truncate_title }} | {{ parent() }}{% endblock %}

{% block content %}
    {% include '@RoadizRozier/nodes/head.html.twig' with {
        node: node,
        title: "edit.node.%name%"|trans({'%name%': currentTitle})|truncate_title,
        available_translations: available_translations,
        current: null,
        with_info_badge: true,
        with_nav_bar: true,
    } only %}

    <section class="rz-page__body">
        {% if form %}
            {% form_theme form '@RoadizRozier/forms.html.twig' %}
            {{ form_start(form) }}
                {{ form_widget(form) }}
                {% import "@RoadizRozier/ui/components/rz_actions_menu.html.twig" as actions_menu %}
                {% if form.use_translate_assistant is defined %}
                    {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with {
                        estimate: estimate ?? null,
                    } only %}
                        {% block body %}
                            {% import '@RoadizRozier/ui/components/rz_message.html.twig' as rz_message %}
                            {% include '@RoadizRozier/ui/patterns/translate_assistant_usage.html.twig' with {
                                label: 'translate_assistant.usage',
                                estimate: estimate,
                            } %}
                            {% if estimate is not null %}
                                {% if estimate.isEmpty %}
                                    {{ rz_message.root({
                                        color: 'warning',
                                        text: 'translate_assistant.estimate.nothing_to_translate'|trans,
                                        attributes: { class: 'rz-form-field__message' },
                                    }) }}
                                {% else %}
                                    {% set estimate_text = 'translate_assistant.estimate.%characters%_characters_for_%sources%_sources'|trans({
                                        '%characters%': estimate.characterCount|number_format(0, '.', ' '),
                                        '%sources%': estimate.sourceCount,
                                    }) %}
                                    {% if estimate.charactersRemaining is not null %}
                                        {% set estimate_text = estimate_text ~ ' ' ~ 'translate_assistant.estimate.%remaining%_characters_remaining'|trans({
                                            '%remaining%': estimate.charactersRemaining|number_format(0, '.', ' '),
                                        }) %}
                                    {% endif %}
                                    {{ rz_message.root({
                                        text: estimate_text,
                                        attributes: { class: 'rz-form-field__message' },
                                    }) }}
                                {% endif %}
                            {% endif %}
                        {% endblock %}
                    {% endembed %}
                {% endif %}
                {{ actions_menu.saveItem({ dataActionSave: '#' ~ field_id(form) }) }}
            {{ form_end(form) }}
        {% else %}
            {% import '@RoadizRozier/ui/components/rz_message.html.twig' as rz_message %}
            {{ rz_message.root({
                color: 'error',
                iconClass: 'rz-icon-ri--error-warning-line',
                text: 'no_more_translation_available'|trans,
            }) }}
        {% endif %}
    </section>

    {% include '@RoadizRozier/nodes/actionsMenu.html.twig' %}
{% endblock %}
