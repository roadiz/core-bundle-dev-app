{% extends '@RoadizRozier/layout.html.twig' %}

{%- block title -%}
    {{ "edit.user.%name%.groups"|trans({'%name%': user.username })|truncate_title }}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
    {% include '@RoadizRozier/users/head.html.twig' with {
        title: "edit.user.%name%.groups"|trans({'%name%': user.username })|truncate_title,
        with_nav_bar: true,
        user: user,
        current: 'groups',
    } only %}

    <section class="rz-page__body">
        {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
            selectionAvailable: false,
            actionsAvailable: true,
        }%}
            {% block thead_cells %}
                <th>{% trans %}group{% endtrans %}</th>
            {% endblock %}

            {% block tbody_content %}
                {% for group in user.getGroups %}
                    <tr>
                        {% if selectionAvailable %}
                            <td>
                                {% import '@RoadizRozier/ui/components/rz_bulk_actions.html.twig' as rz_bulk_actions %}
                                {{ rz_bulk_actions.select_input({ value: group.getId }) }}
                            </td>
                        {% endif %}
                        <td>
                            {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
                            {{ rz_link.root({
                                label: group.getName,
                                attributes: { href: path('groupsEditPage', { id: group.getId })  },
                            }) }}
                        </td>
                        {% if actionsAvailable %}
                            <td>
                                {% if is_granted(group) %}
                                    {% include '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                                        'editHref': path('groupsEditRolesPage', { id: group.getId }),
                                        'editTitle': 'roles'|trans,
                                        'deleteHref': path('usersRemoveGroupsPage', { userId: user.getId, groupId: group.getId }),
                                        'deleteTitle': 'unlink'|trans,
                                    } only %}
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                    {% else %}
                        {{ _self.fallback_row({
                            length: 1,
                            selectionAvailable: selectionAvailable,
                            actionsAvailable: actionsAvailable,
                            message: 'no_groups',
                        }) }}
                    {% endfor %}
            {% endblock %}
        {% endembed %}

        <hr />

        <h2 class="text-h1-sm">{% trans %}add.a.group{% endtrans %}</h2>
        {% form_theme form '@RoadizRozier/forms.html.twig' %}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with { alignStart: true } only %}
                {% block body %}
                    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
                    {{ rz_button.root({
                        size: 'md',
                        label: 'add.group'|trans,
                        iconClass: 'rz-icon-ri--add-line',
                        attributes: {
                            type: 'submit'
                        }
                    }) }}
                {% endblock %}
            {% endembed %}
        {{ form_end(form) }}
    </section>

    {% include '@RoadizRozier/users/actionsMenu.html.twig' %}
{% endblock %}
