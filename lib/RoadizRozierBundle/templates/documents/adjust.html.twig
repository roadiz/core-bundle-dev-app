{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{{ "edit.document.%name%"|trans({'%name%': document})|truncate_title }} | {{ parent() }}{% endblock %}

{% block content %}
    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
    <section class="content-global manage-document">
        {% include '@RoadizRozier/documents/head.html.twig' with {
            document: document,
            title: "edit.document.%name%"|trans({'%name%': document})|truncate_title,
            current: 'adjust',
            with_nav_bar: true,
        } only %}

        <article class="content content-document-edit">
            {% if document and document.image %}
                <rz-image-editor class="rz-image-editor"
                                 filename="{{ document.filename }}"
                                 mime-type="{{ document.mimeType }}"
                                 error-message="{{ 'blanchetteEditor.saveFailed'|trans }}">
                    <div class="rz-image-editor__toolbar">
                        {% set tool_groups = [
                            { name: 'mode', tools: [
                                { action: 'drag-move', title: 'blanchetteEditor.move', icon: 'rz-icon-ri--drag-move-2-line', shortcut: 'M', mode: 'move' },
                                { action: 'drag-crop', title: 'blanchetteEditor.crop', icon: 'rz-icon-ri--crop-line', shortcut: 'C', mode: 'crop' },
                            ] },
                            { name: 'zoom', tools: [
                                { action: 'zoom-in', title: 'blanchetteEditor.zoomIn', icon: 'rz-icon-ri--zoom-in-line', shortcut: 'I' },
                                { action: 'zoom-out', title: 'blanchetteEditor.zoomOut', icon: 'rz-icon-ri--zoom-out-line', shortcut: 'O' },
                            ] },
                            { name: 'transform', tools: [
                                { action: 'rotate-left', title: 'blanchetteEditor.rotateLeft', icon: 'rz-icon-ri--loop-left-line', shortcut: 'L' },
                                { action: 'rotate-right', title: 'blanchetteEditor.rotateRight', icon: 'rz-icon-ri--loop-right-line', shortcut: 'R' },
                                { action: 'flip-horizontal', title: 'blanchetteEditor.flipHorizontal', icon: 'rz-icon-ri--flip-horizontal-2-line', shortcut: 'H' },
                                { action: 'flip-vertical', title: 'blanchetteEditor.flipVertical', icon: 'rz-icon-ri--flip-vertical-2-line', shortcut: 'V' },
                            ] },
                        ] %}

                        {% for group in tool_groups %}
                            <div class="rz-image-editor__group" data-state="editing">
                                <div class="rz-button-group rz-button-group--collapsed">
                                    {% for tool in group.tools %}
                                        {% set attributes = {
                                            type: 'button',
                                            title: tool.title|trans ~ ' (' ~ tool.shortcut ~ ')',
                                            'aria-label': tool.title|trans,
                                            'data-action': tool.action,
                                        } %}
                                        {# The cropper starts in move mode #}
                                        {% set is_active_mode = tool.mode is defined and tool.mode == 'move' %}
                                        {% if tool.mode is defined %}
                                            {% set attributes = attributes|merge({
                                                'aria-pressed': is_active_mode ? 'true' : 'false',
                                                'data-drag-mode': tool.mode,
                                            }) %}
                                        {% endif %}
                                        {# --selected is only styled with an emphasis; secondary looks like the default #}
                                        {{ rz_button.root({
                                            iconClass: tool.icon,
                                            emphasis: tool.mode is defined ? 'secondary' : null,
                                            selected: is_active_mode,
                                            attributes: attributes,
                                        }) }}
                                    {% endfor %}
                                </div>

                                {% if group.name == 'mode' %}
                                    {% import '@RoadizRozier/ui/components/rz_select.html.twig' as rz_select %}
                                    {{ rz_select.root({
                                        options: [
                                            { label: 'blanchetteEditor.other'|trans, options: [
                                                { value: 'free', label: 'blanchetteEditor.free'|trans },
                                                { value: '1:1', label: '1:1' },
                                                { value: '4:3', label: '4:3' },
                                            ] },
                                            { label: 'blanchetteEditor.landscape'|trans, options: [
                                                { value: '16:9', label: '16:9' },
                                                { value: '21:9', label: '21:9' },
                                            ] },
                                            { label: 'blanchetteEditor.portrait'|trans, options: [
                                                { value: '9:16', label: '9:16' },
                                                { value: '9:21', label: '9:21' },
                                            ] },
                                        ],
                                        attributes: {
                                            class: 'rz-image-editor__select',
                                            'data-aspect-ratio': true,
                                            title: 'blanchetteEditor.aspectRatio'|trans,
                                            'aria-label': 'blanchetteEditor.aspectRatio'|trans,
                                        },
                                    }) }}
                                {% endif %}
                            </div>
                        {% endfor %}

                        <div class="rz-image-editor__actions rz-button-group" data-state="editing">
                            {{ rz_button.root({
                                label: 'blanchetteEditor.reset',
                                iconClass: 'rz-icon-ri--arrow-go-back-line',
                                attributes: {
                                    type: 'button',
                                    title: 'blanchetteEditor.reset'|trans ~ ' (0)',
                                    'data-action': 'reset',
                                },
                            }) }}
                            {{ rz_button.root({
                                label: 'blanchetteEditor.applyChange',
                                iconClass: 'rz-icon-ri--check-line',
                                attributes: { type: 'button', 'data-action': 'crop' },
                            }) }}
                        </div>

                        <div class="rz-image-editor__actions rz-button-group" data-state="cropped" hidden>
                            {{ rz_button.root({
                                label: 'blanchetteEditor.undo',
                                iconClass: 'rz-icon-ri--arrow-go-back-line',
                                attributes: { type: 'button', 'data-action': 'undo' },
                            }) }}
                            {{ rz_button.root({
                                label: 'blanchetteEditor.saveAndOverwrite',
                                iconClass: 'rz-icon-ri--save-line',
                                attributes: { type: 'button', 'data-action': 'overwrite' },
                            }) }}
                        </div>
                    </div>

                    <div class="rz-image-editor__canvas">
                        <div class="rz-image-editor__loader" data-loader hidden>
                            <span class="rz-spinner rz-spinner--lg"></span>
                        </div>
                        <img class="rz-image-editor__image"
                             data-image
                             src="{{ document|url({ 'noProcess': true }) }}"
                             alt="{{ document.filename }}"
                             {% if document.imageWidth %}width="{{ document.imageWidth }}"{% endif %}
                             {% if document.imageHeight %}height="{{ document.imageHeight }}"{% endif %}>
                    </div>

                    <div hidden>
                        {{ form(file_form) }}
                    </div>
                </rz-image-editor>
            {% endif %}
        </article>
    </section>
{% endblock %}
