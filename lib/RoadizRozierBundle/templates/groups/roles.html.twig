{% extends '@RoadizRozier/layout.html.twig' %}
{% import "@RoadizRozier/ui/components/rz_button.html.twig" as rz_button %}

{% block title %}{{- "edit.group.%name%.roles"|trans({'%name%': item.getName})|truncate_title }} | {{ parent() }}{% endblock %}

{% block content %}
<section class="content-global edit-group">
    {% include '@RoadizRozier/groups/head.html.twig' with {
        title: 'edit.group.%name%.roles'|trans({'%name%': item.name})|truncate_title,
        item: item,
        current: 'roles',
        with_nav_bar: true,
    } only %}

    <article>
        {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
            selectionAvailable: false,
            actionsAvailable: true,
        } %}
            {% block thead_cells %}
                <th>{% trans %}role{% endtrans %}</th>
            {% endblock %}

            {% block tbody_content %}
                {%- for role in item.roles -%}
                    <tr>
                        <td>{{ role }}</td>
                        {% if actionsAvailable %}
                            <td>
                                {% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                                    'deleteHref': is_granted(role) ? path('groupsRemoveRolesPage', { id: item.id, role: role }) : null,
                                    'deleteTitle': 'unlink.role'|trans,
                                } %}
                                {% endembed %}
                            </td>
                        {% endif %}
                    </tr>
                {%- endfor -%}
            {% endblock %}
        {% endembed %}
        <hr />
        <h2 class="text-h1-sm">{% trans %}add.a.role{% endtrans %}</h2>

        {% form_theme form '@RoadizRozier/forms.html.twig' %}
        {{ form_start(form) }}
        {{ form_widget(form) }}
        {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with { alignStart: true } only %}
            {% block body %}
                {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
                {{
                rz_button.root({
                    attributes: {
                        type: 'submit',
                    },
                    emphasis: 'primary',
                    label: 'add.role',
                    iconClass: 'rz-icon-ri--add-line',
                })
                }}
            {% endblock %}
        {% endembed %}
        {{ form_end(form) }}
    </article>
    {% include '@RoadizRozier/groups/actionsMenu.html.twig' %}
</section>
{% endblock %}
