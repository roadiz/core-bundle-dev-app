{% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
    filters: filters,
    displaySelectAllButton: true,
    displayLayoutFields: true,
    availablePlatforms: availablePlatforms,
    embedPlatform: embedPlatform,
} only %}
    {% block before_submit %}
        {% if availablePlatforms is defined and availablePlatforms|length > 0 %}
            {% import '@RoadizRozier/ui/components/rz_select.html.twig' as rz_select %}
            {% set platform_options = [
                { value: '', label: 'document.no_embed_platform'|trans },
                { value: 'unsplash', label: 'random.document'|trans, selected: embedPlatform == 'unsplash' },
            ] %}
            {% for availablePlatform, class in availablePlatforms %}
                {% set platform_options = platform_options|merge([{
                    value: availablePlatform,
                    label: availablePlatform|capitalize,
                    selected: embedPlatform == availablePlatform,
                }]) %}
            {% endfor %}
            {{ rz_select.root({
                options: platform_options,
                attributes: {
                    name: 'embedPlatform',
                    id: 'embedPlatform',
                    onchange: 'this.form.submit()',
                },
            }) }}
        {% endif %}
    {% endblock %}
{% endembed %}
