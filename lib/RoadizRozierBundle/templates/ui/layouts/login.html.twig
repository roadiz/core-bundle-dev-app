{% extends '@RoadizRozier/ui/layouts/simple.html.twig' %}

{% block content %}
    <div class="rz-login">
        <section class="rz-login__section">
            <header class="rz-login__header">
                <span class="rz-brand">RZ</span>
                {% import '@RoadizRozier/ui/components/rz_badge.html.twig' as rz_badge %}
                {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
                {{ rz_badge.root({ label: cms_prefix ~ ' ' ~ cms_version }) }}
                {% if not hide_website %}
                    {% set publicUrl = '/' %}
                    {% if app.request.basePath %}
                        {% set publicUrl = app.request.basePath %}
                    {% endif %}
                    {% if custom_public_scheme %}
                        {% set publicUrl = custom_public_scheme %}
                    {% endif %}
                    {{ rz_button.root({
                        emphasis: 'secondary',
                        label: 'view.site',
                        iconClass: 'rz-icon-ri--arrow-right-up-line',
                        attributes: {
                            class: 'rz-login__item--end',
                            href: publicUrl,
                            target: '_blank',
                        },
                    }) }}
                {% endif %}
            </header>
            <div class="rz-login__body">
                <h1 class="rz-login__title">{% block login_title %}{% trans %}back_office{% endtrans %}{% endblock %}</h1>
                {% block login_content %}{% endblock %}

                {% set login_footer %}
                    {% block login_footer %}{% endblock %}
                {% endset %}

                {% if login_footer|trim is not empty %}
                    <footer class="rz-login__group rz-login__group--last">
                        {{ login_footer|raw }}
                    </footer>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
