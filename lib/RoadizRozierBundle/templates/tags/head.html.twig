{# A caller that already composed its own trail (confirm_action) keeps it. #}
{% if breadcrumb is not defined or not breadcrumb %}
    {% set root = breadcrumb_root('tags') %}
    {% set tag = tag is defined and tag ? tag : null %}
    {% set breadcrumb = {
        parents: app.request.attributes.get('_route') == root.route
            ? []
            : [root]|merge(tag ? tag.parents(null, true) : breadcrumb_parents|default([])),
        current: tag ? tag.getTagName : title,
    } %}
{% endif %}

{% include "@RoadizRozier/admin/head.html.twig" with {
    item: tag,
    translation_route: 'tagsEditTranslatedPage',
    translation_params: {tagId: tag.id},
    available_translations: available_translations,
    translation: translation,
    title: title,
    buttons: buttons,
    filters: filters,
    with_nav_bar: with_nav_bar,
    nav_bar_template: '@RoadizRozier/tags/navBar.html.twig',
    nav_bar_context: {"tag": tag, "current": current},
    breadcrumb: breadcrumb,
} only %}
