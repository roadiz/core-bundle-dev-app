{% embed "@RoadizRozier/ui/components/rz_actions_menu.html.twig" with {
    vertical: true,
    class: 'actions-menu',
    folder: folder
} only %}
    {% block items %}
        {% if folder.getId %}
            {% if not folder.locked %}
                {{ _self.deleteItem({ label: 'delete.folder', attributes: { href: path('foldersDeletePage', { folderId: folder.getId }) } }) }}
            {% endif  %}
            {{ _self.item({ button: {
                label: 'download',
                emphasis: 'tertiary',
                iconClass: 'rz-icon-ri--download-line',
                attributes: {
                    href: path('foldersDownloadPage', { folderId: folder.getId }),
                },
            } }) }}
        {% endif %}
    {% endblock %}
{% endembed %}
