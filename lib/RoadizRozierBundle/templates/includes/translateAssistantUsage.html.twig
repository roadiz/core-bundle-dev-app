{#
 # Character quota of the current translate-assistant provider.
 # Renders nothing when no provider is wired, or when the provider exposes no quota.
 #
 # label     Translation key heading the bar, next to the percentage, which pushes the
 #           character count down to the hint. Omit it under a panel heading that would
 #           repeat it: the character count then heads the bar on its own.
 # estimate  TranslateAssistantEstimate of an upcoming run, drawn as a hatched projection.
 #}
{% if translateAssistantEnabled %}
    {% set assistantUsage = translateAssistantUsage() %}
    {% if assistantUsage %}
        {% import '@RoadizRozier/macros/rz_progress.html.twig' as rz_progress %}

        {# An empty estimate consumes nothing: it has no projection to draw. #}
        {% set assistantEstimate = estimate|default(null) %}
        {% set assistantEstimate = (assistantEstimate and not assistantEstimate.isEmpty) ? assistantEstimate : null %}

        {# Already translated, so it can carry the formatted counts. The macro runs it
         # through `trans` again, which leaves an untranslatable string untouched. #}
        {% set usageLabel = 'translate_assistant.usage.%count%_of_%limit%_characters'|trans({
            '%count%': assistantUsage.characterCount|number_format(0, '.', ' '),
            '%limit%': assistantUsage.characterLimit|number_format(0, '.', ' '),
        }) %}

        {% if assistantUsage.isLimitReached or (assistantEstimate and not assistantEstimate.fitsInQuota) %}
            {% set usageState = 'error' %}
        {% elseif assistantUsage.percentage >= 80 %}
            {% set usageState = 'warning' %}
        {% else %}
            {% set usageState = null %}
        {% endif %}

        {% set heading = label|default(null) %}

        {{ rz_progress.root({
            label: heading ?? usageLabel,
            value: assistantUsage.characterCount,
            max: assistantUsage.characterLimit,
            projection: assistantEstimate ? assistantEstimate.characterCount : 0,
            state: usageState,
            hint: heading ? usageLabel : null,
        }) }}
    {% endif %}
{% endif %}
