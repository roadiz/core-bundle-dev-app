{# A caller that already composed its own trail (confirm_action) keeps it. #}
{% if breadcrumb is not defined or not breadcrumb %}
    {% set root = breadcrumb_root('folders') %}
    {% set folder = folder is defined and folder ? folder : null %}
    {% set breadcrumb = {
        parents: app.request.attributes.get('_route') == root.route
            ? []
            : [root]|merge(folder ? folder.getParents : breadcrumb_parents|default([])),
        current: folder ? folder.name|default(folder.folderName) : title,
    } %}
{% endif %}

{% include "@RoadizRozier/admin/head.html.twig" with {
    translation_route: 'foldersEditTranslationPage',
    translation_params: {
        folderId: folder.id,
    },
    nav_bar_template: '@RoadizRozier/folders/navBar.html.twig',
    nav_bar_context: {folder: folder, current: current, translation: translation},
    breadcrumb: breadcrumb,
} %}
