{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "assets/*": ["./app/assets/*"]
    }
  },
  "include": [
      "vite.config.ts",
      "app/**/*",
      ".storybook/**/*",
      "vite-plugins/**/*",
      "stories/**/*",
    ]
}
