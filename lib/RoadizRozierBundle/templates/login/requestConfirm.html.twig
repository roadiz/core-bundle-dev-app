{% extends '@RoadizRozier/ui/layouts/login.html.twig' %}

{% block login_content %}
    <p class="text-body-md rz-login__group">{% trans %}a.personal.password.reset.link.has.been.sent.to.your.account.email{% endtrans %}</p>
{% endblock %}

{% block login_footer %}
    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
    {{ rz_button.root({
        emphasis: 'primary',
        label: 'back_to.login',
        iconClass: 'rz-icon-ri--arrow-left-s-line',
        attributes: { href: path('loginPage') },
    }) }}
{% endblock %}
