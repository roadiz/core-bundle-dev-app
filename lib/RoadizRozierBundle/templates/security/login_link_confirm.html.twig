{% extends '@RoadizRozier/ui/layouts/login.html.twig' %}

{% block title %}{% trans %}login_link.confirm{% endtrans %} | {{ parent() }}{% endblock %}

{% block login_content %}
    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
    <p class="text-body-md rz-login__group">{% trans %}login_link.confirm.description{% endtrans %}</p>
    <form id="login-link-confirm-form" class="rz-login__group rz-login__group--last" action="{{ confirm_url }}" method="post">
        {{ rz_button.root({
            emphasis: 'primary',
            label: 'login_link.confirm.button',
            iconClass: 'rz-icon-ri--arrow-right-s-line',
            attributes: { type: 'submit' },
        }) }}
    </form>
    <script>document.getElementById('login-link-confirm-form').submit();</script>
{% endblock %}
