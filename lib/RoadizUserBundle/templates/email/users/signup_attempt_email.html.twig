{% extends '@RoadizUser/email/users/reset_password_email.html.twig' %}

{% block title %}<title>{% trans %}signup.email_already_used.notification{% endtrans %}</title>{% endblock %}

{% block content_title %}
    <h1 itemprop="name">{% trans %}signup.email_already_used.notification{% endtrans %}</h1>
{% endblock %}

{% block content_subtitle %}
    <h2>{{ 'someone.tried.to.sign.up.with.your.email.on.%site%'|trans({'%site%':meta.siteName})|escape }}</h2>
{% endblock %}

{% block content_disclaimer %}
    <p>
        {% trans %}if.this.wasnt.you.ignore.this.email{% endtrans %}
    </p>
{% endblock %}
