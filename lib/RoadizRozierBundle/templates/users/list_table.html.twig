{% embed '@RoadizRozier/ui/components/rz_table.html.twig' %}
	{% block thead_cells %}
		{% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
		<th class="mobile-hidden rz-table__cell--from-lg">
			{% set label = 'user.username'|trans %}
			{% if not no_sort %}
				{{ rz_table.column_ordering({
					field: 'username',
					filters: filters,
					label: label,
				}) }}
			{% else %}
				{{ label }}
			{% endif %}
		</th>
		<th class="mobile-hidden">
			{% set label = 'user.email'|trans %}
			{% if not no_sort %}
				{{ rz_table.column_ordering({
					field: 'email',
					filters: filters,
					label: label,
				}) }}
			{% else %}
				{{ label }}
			{% endif %}
		</th>
		<th class="mobile-hidden">
			{% set label = 'user.lastLogin'|trans %}
			{% if not no_sort %}
				{{ rz_table.column_ordering({
					field: 'lastLogin',
					filters: filters,
					label: label,
				}) }}
			{% else %}
				{{ label }}
			{% endif %}
		</th>
		<th class="mobile-hidden rz-table__cell--from-lg">
			{% trans %}user.roles{% endtrans %}
		</th>
		<th class="mobile-hidden">
			{% trans %}user.status{% endtrans %}
		</th>
	{% endblock %}

	{% block tbody_content %}
		{% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
		{% import '@RoadizRozier/ui/components/rz_bulk_actions.html.twig' as rz_bulk_actions %}
		{% import '@RoadizRozier/ui/components/rz_badge.html.twig' as rz_badge %}

		{% for item in items %}
			<tr>
				{% if selectionAvailable %}
                    <td>
                        {{ rz_bulk_actions.select_input({ value: item.id }) }}
                    </td>
                {% endif %}
				<td class="rz-table__cell--flex" >
					<rz-entity-thumbnail
						title="{{ item.username }}"
						class="rz-entity-thumbnail--medium"
						entity-class="RZ\Roadiz\CoreBundle\Entity\User"
						entity-id="{{ item.id }}"
					></rz-entity-thumbnail>
					{% if is_granted('ROLE_SUPERADMIN') or not item.SuperAdmin %}
						{{ rz_link.root({
							label: item.username|u.truncate(30),
							attributes: { href: path('usersEditPage', { id: item.id })  },
						}) }}
					{% else %}
						{{- item.username|u.truncate(30) -}}
					{% endif %}
				</td>
				<td class="mobile-hidden">{{ item.email|u.truncate(30) }}</td>
				<td class="mobile-hidden">
					{% if item.lastLogin %}
						{{ item.lastLogin|format_datetime }}
					{% else %}
						{% trans %}user.neverLoggedIn{% endtrans %}
					{% endif %}
				</td>
				<td class="mobile-hidden rz-table__cell--from-lg">
					{% transchoice item.roles|length %}{0} no.role|{1} 1.role|]1,Inf] %count%.roles{% endtranschoice %}
				</td>
				<td class="mobile-hidden">
					{% set label_status = item.enabled ? 'user.enabled' : 'user.disabled' %}
					{% set color_status = item.enabled ? 'success' : 'danger' %}
					{% set icon_status = item.enabled ? 'rz-icon-ri--check-line' : 'rz-icon-ri--close-line' %}

					{% if item.enabled is defined %}
						{{ rz_badge.root({
							color: color_status,
							iconClass: icon_status,
							attributes: {
								title: label_status|trans,
							}
						}) }}
					{% endif %}

					{% if item.accountNonLocked is defined and not item.accountNonLocked %}
						{{ rz_badge.root({
							color: 'warning',
							iconClass: 'rz-icon-ri--lock-2-line',
							attributes: {
								title: 'user.locked'|trans,
							}
						}) }}
					{% endif %}

					{% if
						(item.credentialsNonExpired is defined and not item.credentialsNonExpired)
					 or (item.accountNonExpired is defined and not item.accountNonExpired) %}
						{{ rz_badge.root({
							color: 'danger',
							iconClass: 'rz-icon-rz--status-pending-line',
							attributes: {
								title: 'user.expired'|trans,
							}
						}) }}
					{% endif %}
				</td>
				{% if actionsAvailable %}
                    <td>
						{% if is_granted('ROLE_SUPERADMIN') or not item.SuperAdmin %}
							{% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
								'editHref': path('usersEditPage', { id: item.id }),
								'deleteHref': is_granted('ROLE_ACCESS_USERS_DELETE') ? path('usersDeletePage', { id: item.id }) : null,
							} %}
								{% block other_actions %}
									{% if not (item.username == app.user.username or is_granted('IS_IMPERSONATOR')) %}
										{{ _self.button({
											iconClass: 'rz-icon-ri--spy-line',
											attributes: {
												href: path('adminHomePage') ~ '?_su=' ~ item.username|url_encode,
												title: 'start.test.user.right'|trans,
											}
										}) }}
									{% endif %}
								{% endblock %}
							{% endembed %}
						{% endif %}
                    </td>
                {% endif %}
			</tr>
		{% else %}
			{{ _self.fallback_row({
				length: 5,
				selectionAvailable: selectionAvailable,
				actionsAvailable: actionsAvailable,
				message: 'no_users',
			}) }}
		{% endfor %}
	{% endblock %}
{% endembed %}
