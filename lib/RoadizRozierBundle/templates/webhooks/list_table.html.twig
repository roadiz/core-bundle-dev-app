{% embed '@RoadizRozier/ui/components/rz_table.html.twig' %}
	{% block thead_cells %}
		{% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
		<th>{% trans %}webhooks.description{% endtrans %}</th>
		<th>
			{% if not no_sort %}
				{{ rz_table.column_ordering({
					field: 'messageType',
					filters: filters,
					label: 'webhooks.messageType'|trans,
				}) }}
			{% else %}
			    {% trans %}webhooks.messageType{% endtrans %}
			{% endif %}
		</th>
		<th>{% trans %}webhooks.automatic{% endtrans %}</th>
		<th>
			{% if not no_sort %}
				{{ rz_table.column_ordering({
					field: 'lastTriggeredAt',
					filters: filters,
					label: 'webhooks.lastTriggeredAt'|trans,
				}) }}
			{% else %}
				{% trans %}webhooks.lastTriggeredAt{% endtrans %}
			{% endif %}
		</th>
	{% endblock %}

	{% block tbody_content %}
		{% for item in items %}
			<tr>
				{% if selectionAvailable %}
				<td>
					{% import '@RoadizRozier/ui/components/rz_bulk_actions.html.twig' as rz_bulk_actions %}
					{{ rz_bulk_actions.select_input({ value: item.id }) }}
				</td>
				{% endif %}
				<td title="{{ item.description }}">{{- item.description|centralTruncate(30) -}}</td>
				<td title="{{ item.messageType }}" class="rz-table__cell--ellipsis rz-table__cell--rtl">
					{{- item.messageType -}}
				</td>
				<td>
					{% if item.Automatic %}
						<rz-tooltip
							title="{% trans %}webhooks.automatic.help{% endtrans %}"
							class="uk-button-status"
						>
							<i class="uk-icon-flag-checkered"></i>
						</rz-tooltip>
					{% endif %}
				</td>
				<td>{{- item.lastTriggeredAt ? item.lastTriggeredAt|format_datetime(locale=app.request.locale) : 'never'|trans -}}</td>
				{% if actionsAvailable %}
					<td>
						{% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
							'editHref': path('webhooksEditPage', { id: item.id }),
							'deleteHref': path('webhooksDeletePage', { id: item.id }),
						} %}
							{% block other_actions %}
								{{ _self.button({
									iconClass: 'rz-icon-ri--space-ship-line',
									attributes: {
										href: path('webhooksTriggerPage', { id: item.id }),
										title: 'webhook.trigger'|trans,
									}
								}) }}
							{% endblock %}
						{% endembed %}
					</td>
				{% endif %}
			</tr>
		{% else %}
			{{ _self.fallback_row({
				length: 4,
				selectionAvailable: selectionAvailable,
				actionsAvailable: actionsAvailable,
				message: 'no_webhooks',
			}) }}
		{% endfor %}
	{% endblock %}
{% endembed %}
