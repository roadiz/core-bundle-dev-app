{% extends '@RoadizRozier/layout.html.twig' %}


{% block content %}
<section class="content-global download-document">
	<header class="content-header header-document header-document-preview">
        <h1 class="content-title document-download-title">{{ "download.documents"|trans()|truncate_title }}</h1>
    </header>

    <article class="content content-download content-no-action-menu">
        {% form_theme form '@RoadizRozier/forms.html.twig' %}
        {{ form_start(form, {
            'action': action,
            'attr': { id: "documents-bulk-download-form"}
        }) }}
            {{ form_widget(form) }}
            {% import '@RoadizRozier/ui/components/rz_message.html.twig' as rz_message %}
            {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
            {{ rz_message.root({ text: 'are_you_sure.download.these.documents'|trans, attributes: { class: 'rz-form-field__message' } }) }}
            <div class="rz-button-group rz-button-group--gap-md">
                {{ rz_button.root({
                    emphasis: 'secondary',
                    label: 'cancel',
                    iconClass: 'rz-icon-ri--corner-down-left-line',
                    attributes: { href: path('documentsHomePage') },
                }) }}
                {{ rz_button.root({
                    emphasis: 'primary',
                    label: 'download',
                    iconClass: 'rz-icon-ri--download-line',
                    attributes: { type: 'submit' },
                }) }}
            </div>
        {{ form_end(form) }}

        <div class="documents-list">
        {% for document in documents %}
        {% include '@RoadizRozier/documents/singleDocumentThumbnail.html.twig' with {
            document: document,
            thumbnailFormat: thumbnailFormat,
            controls: false
        } only %}
        {% endfor %}
        </div>
	</article>
</section>
{% endblock %}
