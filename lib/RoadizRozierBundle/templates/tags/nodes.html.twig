{% extends '@RoadizRozier/layout.html.twig' %}
{% set tTag = tag.getTranslatedTags.first %}

{%- block title -%}
    {{ tTag.getName }}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
    {% include '@RoadizRozier/tags/head.html.twig' with {
        title: tTag.getName,
        filters: filters,
        with_nav_bar: true,
        tag: tag,
        current: 'nodes',
        available_translations: available_translations,
        translation: translation,
    } only %}

    {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
        filters: filters,
        displaySelectAllButton: false,
    }  only %}{% endembed %}

    <section>
        {% include '@RoadizRozier/nodes/list_table.html.twig' with {
            sortable: false,
            selectionAvailable: false,
            actionsAvailable: true,
            nodes: nodes,
        } only %}
    </section>
{% endblock %}
