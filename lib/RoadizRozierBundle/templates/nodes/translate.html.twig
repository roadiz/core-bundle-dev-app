
{% set currentTitle = node.nodeSources.first.title|default(node.nodeName) %}

{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{{ "edit.node.%name%"|trans({'%name%': currentTitle})|u.truncate(25, '[…]', true) }} | {{ parent() }}{% endblock %}

{% block content %}
<section class="content-global">
    <header class="content-header header-node header-node-edit">
        {% include '@RoadizRozier/nodes/breadcrumb.html.twig' with {"node": node} only %}
        <h1 class="content-title node-edit-title">
            {{ "edit.node.%name%"|trans({'%name%': currentTitle})|u.truncate(25, '[…]', true) }}
            {% include '@RoadizRozier/nodes/nodeTypeCircle.html.twig' %}
        </h1>
        {% include '@RoadizRozier/nodes/navBack.html.twig' %}
        {% include '@RoadizRozier/nodes/navBar.html.twig' with {"current": null} %}
        {% include '@RoadizRozier/nodes/translationBar.html.twig' with {"current": null} %}
    </header>

    <article class="content content-node-translate">
        <div class="content-table-cont">
        {% if form %}
            {% form_theme form '@RoadizRozier/forms.html.twig' %}
            {{ form_start(form) }}
            {{ form_widget(form) }}
            {% if form.use_translate_assistant is defined %}
                <div class="uk-form-row translate-assistant-usage-cont" style="max-width: 500px;">
                    <div class="uk-text-small uk-text-muted" style="margin-bottom: 6px;">{% trans %}translate_assistant.usage{% endtrans %}</div>
                    {% include '@RoadizRozier/includes/translateAssistantUsage.html.twig' %}
                    {% if estimate is defined %}
                        {% if estimate.isEmpty %}
                            <p class="uk-alert uk-alert-warning" style="margin-top: 10px;"><i class="uk-icon uk-icon-info-circle"></i> {% trans %}translate_assistant.estimate.nothing_to_translate{% endtrans %}</p>
                        {% else %}
                            <p class="uk-alert {{ estimate.fitsInQuota ? 'uk-alert-success' : 'uk-alert-danger' }}" style="margin-top: 10px;">
                                <i class="uk-icon uk-icon-{{ estimate.fitsInQuota ? 'check' : 'warning' }}"></i>
                                {{ 'translate_assistant.estimate.%characters%_characters_for_%sources%_sources'|trans({
                                    '%characters%': estimate.characterCount|number_format(0, '.', ' '),
                                    '%sources%': estimate.sourceCount,
                                }) }}
                                {% if estimate.charactersRemaining is not null %}
                                    <br><small>{{ 'translate_assistant.estimate.%remaining%_characters_remaining'|trans({
                                        '%remaining%': estimate.charactersRemaining|number_format(0, '.', ' '),
                                    }) }}</small>
                                {% endif %}
                            </p>
                        {% endif %}
                    {% endif %}
                </div>
            {% endif %}
            <fieldset data-uk-margin>
                <button class="uk-button uk-button-primary" type="submit">
                    <span class="icon-container"><i class="uk-icon-rz-save-mini"></i></span>
                    <span class="label"><span class="label-text">{% trans %}translate{% endtrans %}</span></span>
                </button>
            </fieldset>
            {{ form_end(form) }}
        {% else %}
            <p class="uk-alert uk-alert-warning"><i class="uk-icon uk-icon-warning"></i> {% trans %}no_more_translation_available{% endtrans %}</p>
        {% endif %}
        </div>
    </article>
</section>
{% endblock %}
