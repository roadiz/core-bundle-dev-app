{% embed "@RoadizRozier/ui/components/rz_actions_menu.html.twig" with {
    vertical: true,
    class: 'actions-menu',
    node: node,
    source: source,
    translation: translation,
    versions: versions,
    currentVersion: currentVersion,
    loop: loop,
    max_versions_showed: max_versions_showed,
    readOnly: readOnly,
    live_preview_source: live_preview_source,
} only %}
    {% block items %}
    {# Only defined by nodes/editSource.html.twig, on headless installations. #}
    {% if live_preview_source is defined and live_preview_source %}
        {{ _self.item({ button: {
            emphasis: 'primary',
            iconClass: 'rz-icon-ri--eye-line',
            attributes: {
                class: 'rz-live-preview-toggle',
                title: 'live_preview'|trans,
                'popover-placement': 'left',
                'aria-controls': "live-preview",
                'aria-expanded': "false",
            },
        } }) }}
    {% endif %}
    {% if node %}
        {% if not readOnly and is_granted('DELETE', node) %}
            {% set canDelete = workflow_can(node, 'delete') %}

            {% if workflow_can(node, 'undelete') %}
                {{ _self.item({ button: {
                    emphasis: 'primary',
                    color: 'danger',
                    iconClass: 'rz-icon-ri--device-recover-line',
                    attributes: {
                        href: path('nodesUndeletePage', { nodeId: node.getId}),
                        title: 'undelete'|trans,
                        'popover-placement': 'left',
                    },
                } }) }}
            {% endif %}

            {% if canDelete and node.nodeSources|length > 1 and source %}
                {{ _self.item({ button: {
                    emphasis: 'primary',
                    color: 'danger',
                    iconClass: 'rz-icon-ri--flag-off-line',
                    attributes: {
                        href: path('nodesDeleteSourcePage', { nodeSourceId: source.id }),
                        title: 'delete.translation'|trans,
                        'popover-placement': 'left',
                    },
                } }) }}
            {% endif %}

            {% if canDelete and (node.nodeSources|length == 1 or source.translation.defaultTranslation)  %}
                {{ _self.deleteItem({ attributes: ({
                        title: 'delete.node'|trans,
                        'popover-placement': 'left',
                    })|merge({ href: path('nodesDeletePage', {
                        nodeId: node.getId,
                        referer: node.parent ? getBreadcrumbsItem(node.parent).url : null
                    }) }) }) }}
            {% endif %}
        {% endif %}

        {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
        {% set canPublish = workflow_can(node, 'publish') %}
        {% if not node.isDeleted %}
            <rz-popover
                popover-placement="left-start"
                popover-offset="18px"
                >
                    {{ rz_button.root({
                        iconClass: 'rz-icon-ri--settings-4-line',
                        emphasis: 'tertiary',
                        onDark: true,
                        attributes: {
                            title: 'actions'|trans,
                            popovertarget: 'action-menu',
                            'popover-placement': 'left',
                        }
                    }) }}
                {% embed "@RoadizRozier/ui/components/rz_dropdown.html.twig" with {
                    title: 'actions',
                    reverse: true,
                    targetId: 'action-menu'
                } %}
                    {% block items %}
                        {% if source and source.Reachable %}
                            {% if node.published %}
                                {{ _self.item({
                                    label: 'see.page',
                                    attributes: { href: path('nodesSourcesPublicRedirect', {
                                        'nodeSourceId': source.id,
                                    }) },
                                    iconClass: 'rz-icon-ri--eye-line',
                                    rightIconClass: 'rz-icon-ri--arrow-right-s-line',
                                }) }}
                            {% endif %}
                            {% if (node.published or node.draft or node.pending) and is_granted(preview_required_role) %}
                                {{ _self.item({
                                    label: 'preview.page',
                                    attributes: { href: path('nodesSourcesPreviewRedirect', {
                                        'nodeSourceId': source.id,
                                    }) },
                                    iconClass: 'rz-icon-ri--eye-line',
                                    rightIconClass: 'rz-icon-ri--arrow-right-s-line',
                                }) }}
                            {% endif %}
                        {% endif %}
                        {% if not node.isLocked %}
                            {% if is_granted('DUPLICATE', node) %}
                                {{ _self.item({
                                    label: 'duplicate',
                                    attributes: { href: path('nodesDuplicatePage', { nodeId: node.getId }) },
                                    iconClass: 'rz-icon-ri--file-copy-2-line',
                                    rightIconClass: 'rz-icon-ri--arrow-right-s-line',
                                }) }}
                            {% endif %}
                            {% if is_granted('EDIT_SETTING', node) %}
                                {{ _self.item({
                                    label: 'transtype',
                                    attributes: { href: path('nodesTranstypePage', { nodeId: node.getId }) },
                                    iconClass: 'rz-icon-ri--command-line',
                                    rightIconClass: 'rz-icon-ri--arrow-right-s-line',
                                }) }}
                            {% endif %}
                            {% if canPublish %}
                                {{ _self.item({
                                    label: 'publish_node_offspring',
                                    attributes: { href: path('nodesPublishAllAction', { nodeId: node.getId }) },
                                    iconClass: 'rz-icon-ri--checkbox-line',
                                    rightIconClass: 'rz-icon-ri--arrow-right-s-line',
                                }) }}
                            {% endif %}
                        {% endif %}
                        {{ _self.item({
                            label: 'add.child',
                            attributes: { href: path('nodesAddChildPage', { nodeId: node.getId }) },
                            iconClass: 'rz-icon-ri--add-line',
                            rightIconClass: 'rz-icon-ri--arrow-right-s-line',
                        }) }}
                        {% if node.hidingChildren and translation %}
                            {{ _self.item({
                                label: 'export_format.csv.%language%'|trans({'%language%':translation.name }),
                                attributes: { href: path('nodesExportNodeCsvPage', {parentNodeId: node.id, translationId:translation.id}) },
                                iconClass: 'rz-icon-ri--file-pdf-2-line',
                                rightIconClass: 'rz-icon-ri--arrow-right-s-line',
                            }) }}
                        {% endif %}
                    {% endblock %}
                    {% block additional_menu %}
                        <menu class="rz-dropdown__list node-statuses node-actions">
                            {% if workflow_can(node, 'reject') or node.isDraft %}
                                {{ _self.item({
                                    label: 'draft',
                                    iconClass: 'rz-icon-rz--status-draft-fill',
                                    rightIconClass: (node.isDraft) ? 'rz-icon-ri--checkbox-circle-line' : 'rz-icon-ri--checkbox-blank-circle-line',
                                input: {
                                    type: 'radio',
                                    name: 'status',
                                    value: 'reject',
                                    attr: {'data-node-id': node.getId},
                                },
                                }) }}
                            {% endif %}
                            {% if workflow_can(node, 'unarchive') %}
                                {{ _self.item({
                                    label: 'draft',
                                    iconClass: 'rz-icon-rz--status-draft-fill',
                                    rightIconClass: (node.isDraft) ? 'rz-icon-ri--checkbox-circle-line' : 'rz-icon-ri--checkbox-blank-circle-line',
                                input: {
                                    type: 'radio',
                                    name: 'status',
                                    value: 'unarchive',
                                    attr: {'data-node-id': node.getId},
                                },
                                }) }}
                            {% endif %}
                            {% if workflow_can(node, 'review') or node.isPending %}
                                {{ _self.item({
                                    label: 'pending',
                                    iconClass: 'rz-icon-rz--status-pending-fill',
                                    rightIconClass: (node.isPending) ? 'rz-icon-ri--checkbox-circle-line' : 'rz-icon-ri--checkbox-blank-circle-line',
                                input: {
                                    type: 'radio',
                                    name: 'status',
                                    value: 'review',
                                    attr: {'data-node-id': node.getId},
                                },
                                }) }}
                            {% endif %}
                            {% if canPublish or node.isPublished %}
                                {{ _self.item({
                                    label: 'published',
                                    iconClass: 'rz-icon-rz--status-published-fill',
                                    rightIconClass: (node.isPublished) ? 'rz-icon-ri--checkbox-circle-line' : 'rz-icon-ri--checkbox-blank-circle-line',
                                    input: {
                                        type: 'radio',
                                        name: 'status',
                                        value: 'publish',
                                        attr: {'data-node-id': node.getId},
                                    },
                                }) }}
                            {% endif %}
                            {% if workflow_can(node, 'archive') or node.isArchived %}
                                {{ _self.item({
                                    label: 'archived',
                                    iconClass: 'rz-icon-rz--status-archived-fill',
                                    rightIconClass: (node.isArchived) ? 'rz-icon-ri--checkbox-circle-line' : 'rz-icon-ri--checkbox-blank-circle-line',
                                    input: {
                                        type: 'radio',
                                        name: 'status',
                                        value: 'archive',
                                        attr: {'data-node-id': node.getId},
                                    },
                                }) }}
                            {% endif %}
                        </menu>
                    {% endblock %}
                {% endembed %}
            </rz-popover>
        {% endif %}

        {% if versions and versions|length > 1 %}
            <rz-popover
                popover-placement="left-start"
                popover-offset="18px"
            >
                {{ rz_button.root({
                    iconClass: 'rz-icon-ri--git-fork-line',
                    emphasis: 'tertiary',
                    onDark: true,
                    attributes: {
                        title: 'versions'|trans,
                        popovertarget: 'version-menu',
                        'popover-placement': 'left',
                    }
                }) }}
                {% embed "@RoadizRozier/ui/components/rz_dropdown.html.twig" with {
                    title: 'versions',
                    reverse: true,
                    targetId: 'version-menu'
                } %}
                    {% block items %}
                        {{ _self.item({
                            label: 'versions.working_copy',
                            attributes: { href: path('nodesEditSourcePage', {
                                nodeId: node.id,
                                translationId: translation.id
                            }) },
                            selected: not currentVersion,
                        }) }}
                        {% for version in versions %}
                            {% if loop.index0 > 0 and loop.index <= max_versions_showed %}
                                {{ _self.item({
                                    label: version.loggedAt|format_datetime('short', 'short', locale=app.request.locale),
                                    description: version.username,
                                    attributes: { href: path('nodesEditSourcePage', {
                                        nodeId: node.id,
                                        translationId: translation.id,
                                        version: version.version
                                    }) },
                                    selected: currentVersion and currentVersion.id == version.id,
                                }) }}
                            {% endif %}
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            </rz-popover>
        {% endif %}

    {% endif %}
    {% endblock %}
{% endembed %}
