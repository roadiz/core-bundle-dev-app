{#
    Breadcrumb trail.

    breadcrumb:
    - parents (optional): ancestors, from the root down. Each entry is a hash
      {label, url} or an entity supported by a BreadcrumbsItemFactory.
    - current (required): label of the current page, rendered as plain text.

    At most `max_visible` ancestors stay in the trail: past that, the levels right after the
    root fold into a popover, so a deep node tree never pushes the page action buttons off
    screen. When the row is too narrow for what the server left inline, the popover folds more
    levels and unfolds them back as the row widens (utils/OverflowList.ts): the trail is always
    one line. The Storybook renderer mirrors the cap as MAX_VISIBLE in
    app/utils/storybook/renderer/rzBreadcrumb.ts — keep both in step.

    Who builds this hash: a page never declares the root of its own section. Its section
    head does, and works out on its own whether the page *is* that root by comparing the
    current route to the root's. A page only describes the levels in between, through
    `breadcrumb_parents`. Outside a section head — a confirmation page, a section with no
    head of its own — get a root with `breadcrumb_root('<section>')`, never by retyping the
    hash, and the whole path down to a tree entity with `breadcrumb_trail('<section>', item)`.
    See src/Breadcrumbs/BreadcrumbRoots.php for the list of sections.

    A section head keeps a `breadcrumb` its caller already composed: that is how
    admin/confirm_action.html.twig puts the deleted item and its ancestry above its own title.
#}
{% macro root(breadcrumb) %}
    {% set parents = breadcrumb.parents|default([]) %}
    {# Counts ancestors only, the current page excluded. #}
    {% set max_visible = 6 %}
    {# Root and last ancestor never fold; everything in between is the popover's to manage. #}
    {% set middle = parents|length > 2 ? parents|slice(1, parents|length - 2) : [] %}
    {% set folded_count = max(0, parents|length - max_visible) %}

    <nav class="rz-breadcrumb" aria-label="{{ 'breadcrumb'|trans }}">
        <ol class="rz-breadcrumb__list">
            {% if middle is empty %}
                {% for item in parents %}
                    {{ _self.item(item) }}
                {% endfor %}
            {% else %}
                {{ _self.item(parents|first) }}

                {% embed '@RoadizRozier/components/rz_overflow_list.html.twig' with {
                    items: middle|slice(0, folded_count),
                    visibleCount: 0,
                    wrapperTag: 'li',
                    wrapperClass: 'rz-breadcrumb__list-item',
                    responsive: true,
                    responsiveInline: middle|length - folded_count,
                    popover: {
                        tagList: 'ul',
                    },
                    button: {
                        label: '',
                        ariaLabel: 'breadcrumb.show_more',
                    },
                } only %}
                    {% block item %}
                        {% if item is defined %}
                            {% import '@RoadizRozier/components/rz_breadcrumb.html.twig' as rz_breadcrumb %}
                            {{ rz_breadcrumb.item(item) }}
                        {% endif %}
                    {% endblock %}
                {% endembed %}

                {% for item in middle|slice(folded_count) %}
                    {{ _self.item(item) }}
                {% endfor %}

                {{ _self.item(parents|last) }}
            {% endif %}

            {{ _self.item({ label: breadcrumb.current }, true) }}
        </ol>
    </nav>
{% endmacro %}

{#
    One breadcrumb entry. Shared by the trail and by its overflow popover: the markup is the
    same in both places so the responsive collapse (utils/OverflowList.ts) can move a <li>
    between them as is. Folded levels get their menu-entry look from CSS
    (`.rz-overflow-list__list .rz-breadcrumb__item` in rz-breadcrumb.css).

    - item (required): a hash {label, url}, or an entity supported by a
      BreadcrumbsItemFactory (Node, NodesSources, Tag, Folder, Document, Translation).
    - current (optional): render as the current page, as plain text instead of a link.
#}
{% macro item(item, current = false) %}
    {% set item = item is iterable ? item : getBreadcrumbsItem(item) %}
    {% if item %}
        <li class="rz-breadcrumb__list-item">
            {% if current %}
                <span class="rz-breadcrumb__item" aria-current="page">{{- item.label|truncate_title -}}</span>
            {% else %}
                <a class="rz-breadcrumb__item" href="{{ item.url }}">{{- item.label|truncate_title -}}</a>
            {% endif %}
        </li>
    {% endif %}
{% endmacro %}
