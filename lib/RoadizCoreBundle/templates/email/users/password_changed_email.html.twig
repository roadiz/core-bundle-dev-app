{% extends '@RoadizCore/email/users/reset_password_email.html.twig' %}

{% block title %}<title>{% trans %}password.changed.notification{% endtrans %}</title>{% endblock %}

{% block content_title %}
    <h1 itemprop="name">{% trans %}password.changed.notification{% endtrans %}</h1>
{% endblock %}

{% block content_subtitle %}
    <h2>{{ 'your.password.was.changed.on.%site%'|trans({'%site%':meta.siteName})|escape }}</h2>
{% endblock %}

{% block content_action %}
    <p>{% trans %}if.you.did.not.change.your.password.reset.it.now{% endtrans %}</p>
    <p class="aligncenter" itemprop="handler" itemscope itemtype="http://schema.org/HttpActionHandler">
        <a class="btn-primary" href="{{ resetLink|raw }}" itemprop="url">{% trans %}reset_your_password{% endtrans %}</a>
    </p>
{% endblock %}

{% block content_disclaimer %}
{% endblock %}
