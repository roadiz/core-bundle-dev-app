{% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
    nodes: nodes,
    selectionAvailable: selectionAvailable,
    actionsAvailable: actionsAvailable,
} only %}
    {% block thead_cells %}
        {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
        <th>
            {{ rz_table.column_ordering({
                field: 'nodeName',
                label: 'nodeName'|trans,
                filters: filters|default(null),
            }) }}
        </th>
        <th>
            {{ rz_table.column_ordering({
                field: 'nodeTypeName',
                label: 'node.type'|trans,
                filters: filters|default(null),
            }) }}
        </th>
        <th>
            {% trans %}node.status{% endtrans %}
        </th>
        <th>
            {{ rz_table.column_ordering({
                field: 'updatedAt',
                label: 'last.modification'|trans,
                filters: filters|default(null),
            }) }}
        </th>
    {% endblock %}

    {% block tbody_content %}
        {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}

        {% for node in nodes %}
            <tr
                {{ _self.colored_row_attrs({'color': getNodeType(node).color }) }}
            >
                {{ _self.selection_input({ selectionAvailable: selectionAvailable, value: node.id, disabled: node.locked }) }}
                <td class="rz-table__cell--flex">
                    <rz-entity-thumbnail
                        class="mobile-hidden rz-entity-thumbnail--medium"
                        entity-class="RZ\Roadiz\CoreBundle\Entity\Node"
                        entity-id="{{ node.id }}"
                    >
                    </rz-entity-thumbnail>
                    {% set label = node.nodeSources.first.title|default(node.nodeName)%}
                    {{ rz_link.root({
                        label: label|centralTruncate(30, -4),
                        attributes: {
                            href: path('nodesEditPage', { nodeId: node.id }),
                            'aria-label': label,
                        },
                    }) }}
                </td>
                <td class="mobile-hidden">{{ getNodeType(node).displayName }}</td>
                <td class="rz-table__cell">
                    <div class="rz-button-group rz-button-group--nowrap">
                        {% import "@RoadizRozier/ui/components/rz_node_badge.html.twig" as rz_node_badge %}
                        {{ rz_node_badge.all({ node: node, displayLabel: false }) }}
                    </div>
                </td>
                <td class="mobile-hidden rz-table__cell--from-lg">{{ node.updatedAt|format_date('short', locale=app.request.locale) }}</td>
                {% if actionsAvailable %}
                    <td>
                        {% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                            'editHref': path('nodesEditPage', { nodeId: node.id }),
                            'deleteHref': workflow_can(node, 'delete') ? path('nodesDeletePage', { nodeId: node.id }) : null,
                        } %}
                            {% block other_actions %}
                                {{ _self.button({
                                    iconClass: 'rz-icon-ri--node-tree',
                                    attributes: {
                                        href: path('nodesTreePage', { nodeId: node.id }),
                                        title: 'see.nodetree'|trans,
                                    }
                                }) }}
                                {% if workflow_can(node, 'undelete') %}
                                    {{ _self.button({
                                        iconClass: 'rz-icon-ri--device-recover-line',
                                        attributes: {
                                            href: path('nodesUndeletePage', { nodeId: node.id }),
                                            title: 'undelete'|trans,
                                        }
                                    })}}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </td>
                {% endif %}
            </tr>
        {% else %}
            {{ _self.fallback_row({
                length: 4,
                selectionAvailable: selectionAvailable,
                actionsAvailable: actionsAvailable,
                message: 'no_nodes',
            }) }}
        {% endfor %}
    {% endblock %}
{% endembed %}
