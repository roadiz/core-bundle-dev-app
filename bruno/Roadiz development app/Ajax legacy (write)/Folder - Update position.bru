meta {
  name: Folder - Update position
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/rz-admin/ajax/folder/position
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  csrfToken: {{ajaxToken}}
  id: 1
  ~newParentId: 2
  ~prevId: 3
  ~nextId: 4
  ~firstPosition: true
  ~lastPosition: true
}
