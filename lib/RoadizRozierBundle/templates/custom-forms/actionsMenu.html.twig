{% embed "@RoadizRozier/ui/components/rz_actions_menu.html.twig" with {
    vertical: true,
    class: 'actions-menu',
    item: item
} only %}
    {% block items %}
        {% if (is_granted('ROLE_ACCESS_CUSTOMFORMS_DELETE')) %}
            {% if item.id %}
                {{ _self.deleteItem({ attributes: { href: path('customFormsDeletePage', { id: item.id }) } }) }}
                {{ _self.item({ button: {
                    label: 'customForm.duplicate',
                    emphasis: 'tertiary',
                    iconClass: 'rz-icon-ri--file-copy-line',
                    attributes: {
                        href: path('customFormsDuplicatePage', { id: item.id}),
                    },
                } }) }}
            {% endif %}
        {% endif %}
    {% endblock %}
{% endembed %}
