{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{% trans %}upload.document{% endtrans %} | {{ parent() }}{% endblock %}

{% block content %}
<section class="content-global upload-document">
    {% include '@RoadizRozier/documents/head.html.twig' with {
        title: "upload.document"|trans,
    } only %}

    <article class="content content-upload">
        <div class="content-upload-inner">
            {% form_theme form '@RoadizRozier/forms.html.twig' %}
            <form
                class="rz-form"
                action="#"
                method="post"
                enctype="multipart/form-data"
            >
                <div class="rz-form__field-list">
                    {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with {
                        folder: folder,
                        form: form,
                    } only %}
                        {% block body %}
                            <rz-file-upload
                                {% if folder.id %}
                                    url="{{ path('documentsUploadPage', {_format: 'json', folderId: folder.id}) }}"
                                    style="--rz-accent-color: {{ folder.color }};"
                                {% endif %}
                            >
                                <noscript>
                                    {{ form_widget(form) }}
                                    {% embed '@RoadizRozier/ui/components/rz_form_field.html.twig' with { alignStart: true } only %}
                                        {% block body %}
                                            {% import '@RoadizRozier/ui/components/rz_input.html.twig' as rz_input %}
                                            {{ rz_input.root({ type: 'submit', value: 'upload'|trans }) }}
                                        {% endblock %}
                                    {% endembed %}
                                </noscript>
                                {{ form_rest(form) }}
                            </rz-file-upload>
                        {% endblock %}
                    {% endembed %}
                </div>
            </form>
        </div>
    </article>
</section>
{% endblock %}
