{#
    Generic confirmation page for a destructive or irreversible action.

    Controller parameters (camelCase):
    - title (required): page title, also the last breadcrumb entry
    - subtitle (optional): line under the title
    - form (required): the confirmation form
    - headPath (required): head template to include, e.g. '@RoadizRozier/ui/patterns/page_header.html.twig'
    - cancelPath (required): URL of the cancel button
    - alertMessage (required): translation key of the warning shown above the buttons
    - messageType (optional): rz-message modifier, defaults to 'error'
    - items (optional): entities to preview as cards; a single one also seeds the breadcrumb
    - thumbnailFormat (optional): format passed to the item cards

    Template options (snake_case):
    - breadcrumb_parents (optional): breadcrumb ancestors, see ui/components/rz_breadcrumb.html.twig
    - action_label / action_icon / action_color (optional): submit button, defaults to a red "delete"

    Note: the camelCase parameters above predate the naming rule documented in
    docs/developer/contributing/contributing.md. Renaming them is a breaking change.
#}
{% extends '@RoadizRozier/layout.html.twig' %}
{% import "@RoadizRozier/ui/components/rz_button.html.twig" as rz_button %}

{% block title %}{{ title|truncate_title }}{% endblock %}

{% block content %}
    {% if breadcrumb_parents is not defined %}
        {% if items is defined and items|length == 1 and items[0] is iterable %}
            {% set breadcrumb_parents = [items[0]] %}
        {% endif %}
    {% endif %}
    {% set breadcrumb = {
        parents: breadcrumb_parents|default([]),
        current: title,
    } %}
    <section class="content-global delete-document">
        {% include headPath with {
            title: title,
            subtitle: subtitle,
            breadcrumb: breadcrumb,
        } only %}

        <article class="content content-delete content-no-action-menu">
            {% form_theme form '@RoadizRozier/forms.html.twig' %}
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="rz-message rz-message--{{ messageType|default('error') }} rz-form-field__message">
                <p class="rz-message__text">
                    {{ alertMessage|trans }}
                </p>
            </div>
            <div class="rz-button-group rz-button-group--gap-md">
                {{
                    rz_button.root({
                        tag: 'a',
                        attributes: {
                            href: cancelPath,
                        },
                        emphasis: 'secondary',
                        label: 'cancel',
                        iconClass: 'rz-icon-ri--corner-down-left-line',
                    })
                }}
                {{
                    rz_button.root({
                        attributes: {
                            type: 'submit',
                        },
                        emphasis: 'primary',
                        color: action_color|default('danger'),
                        label: action_label|default('delete'),
                        iconClass: action_icon|default('rz-icon-ri--delete-bin-7-line'),
                    })
                }}
            </div>
            {{ form_end(form) }}

            {% if items is defined and items|length > 0 %}
                <ul class="rz-delete-page__body rz-layout-grid">
                    {% for item in items %}
                        {% if item is iterable %}
                            {% set itemExplorer = item %}
                        {% else %}
                            {% set itemExplorer = getExplorerItem(item) %}
                        {% endif %}
                        {{ _self.explorer_card(itemExplorer, thumbnailFormat) }}
                    {% endfor %}
                </ul>
            {% endif %}
        </article>
    </section>
{% endblock %}

{# Maps an explorer item (getExplorerItem) to the rz-card options #}
{% macro explorer_card(item, thumbnailFormat) %}
    {% import '@RoadizRozier/ui/components/rz_card.html.twig' as rz_card %}

    {% set is_image = item.isImage is defined %}
    {% set image = null %}
    {% set badge = null %}

    {% if item.thumbnail is defined and item.thumbnail is not empty %}
        {% set image = { innerHTML: item.thumbnail|display(thumbnailFormat|merge({ class: 'rz-image rz-card__img' })) } %}
    {% elseif item.pictureUrl is defined %}
        {% if item.pictureUrl is null %}
            {% set badge = { size: 'md', iconClass: 'rz-icon-ri--user-line' } %}
        {% else %}
            {% set image = { src: item.pictureUrl, alt: item.displayable|default('Thumbnail') } %}
        {% endif %}
    {% elseif item.thumbnail80 is defined %}
        {% set image = { src: item.thumbnail80, alt: item.displayable|default('Thumbnail'), width: 110, height: 94 } %}
        {% if item.isPrivate %}
            {% set badge = { size: 'md', iconClass: 'rz-icon-ri--lock-2-line' } %}
        {% elseif item.isPdf %}
            {% set badge = { size: 'md', iconClass: 'rz-icon-ri--file-pdf-2-line' } %}
        {% endif %}
    {% endif %}

    {{ rz_card.root({
        tag: 'li',
        overtitle: not is_image and item.classname is defined ? item.classname : null,
        title: not is_image and item.displayable is defined ? item.displayable : null,
        image: image,
        badge: badge,
    }) }}
{% endmacro %}
