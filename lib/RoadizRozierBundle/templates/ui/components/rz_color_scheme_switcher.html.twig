{# rz-color-scheme-switcher: options = RzColorSchemeSwitcherOptions (storybook/renderer/rzColorSchemeSwitcher.ts), story Components/Actions/ColorSchemeSwitcher #}
{# `attributes` go on the rz-popover wrapper. #}
{% macro root(options = {}) %}
    {% set popover_id = options.id|default('color-theme-switcher') %}
    {% set schemes = [
        { value: 'system', label: 'color.system', iconClass: 'rz-icon-ri--computer-line' },
        { value: 'light', label: 'color.light', iconClass: 'rz-icon-ri--sun-line' },
        { value: 'dark', label: 'color.dark', iconClass: 'rz-icon-ri--moon-line' },
    ] %}

    {% embed "@RoadizRozier/ui/components/rz_dropdown.html.twig" with {
        targetId: popover_id,
        wrapper_tag: 'rz-color-scheme-switcher',
        target_options: {
            size: 'sm',
            iconClass: 'rz-icon-ri--color-filter-line',
            attributes: {
                'aria-label': 'show.color.theme'|trans,
            },
        },
        popover_attributes: options.attributes|default({}),
        schemes: schemes,
    } only %}
        {% block items %}
            {% for scheme in schemes %}
                {{ _self.item({
                    selected: scheme.value == 'system',
                    label: scheme.label|trans,
                    rightIconClass: scheme.iconClass,
                    attributes: {
                        type: 'button',
                        'data-value': scheme.value,
                        command: '--update-color-scheme',
                        commandfor: targetId,
                    },
                }) }}
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endmacro %}
