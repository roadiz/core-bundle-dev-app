{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{% trans %}attributes{% endtrans %} | {{ parent() }}{% endblock %}

{% block content %}
    <rz-bulk-section>
        {% include '@RoadizRozier/attributes/head.html.twig' with {
            title: 'attributes'|trans,
            filters: filters,
            buttons: [
                {
                    label: 'add.a.attribute'|trans,
                    attributes: {
                        href: path('attributesAddPage'),
                    },
                    iconClass: 'rz-icon-ri--add-line'
                },
                {
                    label: 'attribute_groups'|trans,
                    attributes: {
                        href: path('attributeGroupsHomePage'),
                    },
                    iconClass: 'rz-icon-ri--folder-2-line'
                },
                {
                    label: 'export.all'|trans,
                    attributes: {
                        class: 'rz-no-ajax-link',
                        href: path('attributesExportPage'),
                    },
                    iconClass: 'rz-icon-ri--download-line',
                },
                {
                    label: 'import'|trans,
                    attributes: {
                        href: path('attributesImportPage'),
                    },
                    iconClass: 'rz-icon-ri--upload-line'
                },
            ],
        } only %}

        {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
            filters: filters,
            displaySelectAllButton: true,
        }  only %}{% endembed %}
        {% include '@RoadizRozier/ui/patterns/bulk_actions.html.twig' %}

        <article>
            {% include '@RoadizRozier/attributes/list_table.html.twig' with {
                selectionAvailable: hasBulkActions,
                actionsAvailable: true,
                filters: filters,
                items: items,
            } only %}
        </article>

    </rz-bulk-section>
{% endblock %}
