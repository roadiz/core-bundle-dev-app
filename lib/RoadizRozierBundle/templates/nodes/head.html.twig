{# Used by the trail below, but also by the badges and buttons further down. #}
{% set node = node is defined and node ? node : null %}
{% set source = source is defined and source ? source : (node ? node.nodeSources.first : null) %}

{# A caller that already composed its own trail (confirm_action) keeps it. #}
{% if breadcrumb is not defined or not breadcrumb %}
    {% set root = breadcrumb_root('nodes') %}

    {% if source %}
        {# A shadow parent hides its own ancestors: the trail stops at it. #}
        {% set breadcrumb_parents = node.parent.shadow == true
            ? [source|parent(null, true)]
            : [root]|merge(source|parents(null, true)|reverse) %}
        {% set breadcrumb = {
            parents: breadcrumb_parents,
            current: source.title|default(node.nodeName),
        } %}
    {% else %}
        {% set breadcrumb = {
            parents: app.request.attributes.get('_route') == root.route
                ? []
                : [root]|merge(breadcrumb_parents|default([])),
            current: title,
        } %}
    {% endif %}
{% endif %}

{% embed "@RoadizRozier/ui/components/rz_page_header.html.twig" with {
    breadcrumb: breadcrumb
} %}
    {% import "@RoadizRozier/ui/components/rz_badge.html.twig" as rz_badge %}
    {% block translation %}
        {% if available_translations is defined and available_translations and translation is defined and translation.id %}
            {% if not route %}
                {% set route = 'nodesEditSourcePage' %}
            {% endif %}
            <div class="rz-page-header__item--right">
                {{ _self.translations_bar({
                    availableTranslations: available_translations,
                    current: translation.id,
                    path: route,
                    pathParams: {nodeId: node.getId},
                    pathAddTranslations: path('nodesTranslatePage', { nodeId: node.getId }),
                    pathAddTranslationsTitle: 'translate.node'|trans,
                }) }}
            </div>
        {% endif %}
    {% endblock %}


    {% block buttons %}
        {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
        {% if node.stackTypes|length and stackTypesButton %}
            <div class="stack-tree-quick-creation rz-button-group rz-button-group--gap-md rz-page-header__item--right">
                {% for stackType in node.stackTypes %}
                    {% set nodeType = getNodeType(stackType) %}
                    {{ rz_button.root({
                        emphasis: 'primary',
                        label: nodeType.displayName,
                        iconClass: 'rz-icon-ri--add-line',
                        attributes: {
                            type: 'button',
                            class: 'rz-button-group__button',
                            'data-children-node-type': nodeType.name,
                            'data-children-parent-node': node.id,
                        }|merge(specificNodeTree.tag.id is defined ? { 'data-filter-tag': specificNodeTree.tag.id } : {}),
                    }) }}
                {% endfor %}
            </div>
        {% endif %}
        {% if nodeTypes is defined and nodeTypes and nodeTypes|length %}
            <div class="rz-button-group--gap-md rz-page-header__item--right">
                {% if mainFilter == 'deleted' %}
                    {{ rz_button.root({
                        emphasis: 'primary',
                        label: 'empty.node.trash',
                        iconClass: 'rz-icon-ri--delete-bin-7-line',
                        attributes: {
                            class: 'rz-button-group__button',
                            href: path('nodesEmptyTrashPage'),
                        },
                    }) }}
                {% else %}
                    <rz-popover popover-placement="bottom-end"
                                popover-offset="10" popover-shift="10"
                                class="rz-page-header__item--right"
                    >
                        {{ rz_button.root({
                            emphasis: 'primary',
                            label: 'export.all.nodes',
                            iconClass: 'rz-icon-ri--download-cloud-2-line',
                            attributes: {
                                popovertarget: 'nodeExport-menu',
                                'aria-label': 'export.all.nodes'|trans,
                            },
                        }) }}

                        {% embed "@RoadizRozier/ui/components/rz_dropdown.html.twig" with {
                            targetId: 'nodeExport-menu',
                            listTag: 'ul',
                            items: availableTranslations,
                        } only %}
                            {% block items %}
                                {% for item in items %}
                                    {{ _self.item({
                                        label: 'export_format.csv.%language%'|trans({'%language%':item.name }),
                                        attributes: { href: path('nodesExportAllCsvPage', {
                                            translationId: item.id
                                        }) },
                                        rightIconClass: 'rz-icon-ri--file-download-line'
                                    }) }}
                                {% endfor %}
                            {% endblock %}
                        {% endembed %}
                    </rz-popover>
                    {{ rz_button.root({
                        emphasis: 'primary',
                        label: 'create.a.node',
                        iconClass: 'rz-icon-ri--add-line',
                        attributes: {
                            class: 'rz-button-group__button',
                            href: path('nodesAddPage', { translationId: translation.getId }),
                        },
                    }) }}
                {% endif %}
            </div>
        {% endif %}
    {% endblock %}

    {% block badges %}
        {% if app.debug and with_debug_badge %}
            <div class="rz-page-header__item">
                {{ rz_badge.root({
                    label: 'NS #' ~ source.id,
                    size: 'sm',
                    color: 'information'
                }) }}
            </div>
        {% endif %}
        {% if filters and filters.itemCount %}
            <div class="rz-page-header__item">
                {{ rz_badge.root({
                    label: '%count%.items'|transchoice(filters.itemCount)|raw,
                    size: 'sm',
                }) }}
            </div>
        {% endif %}
        {% if with_status_badge is defined and with_status_badge %}
            {% import "@RoadizRozier/ui/components/rz_node_badge.html.twig" as rz_node_badge %}
            <div class="rz-page-header__item">
                {{ rz_node_badge.status({ node: node }) }}
                {{ rz_node_badge.parameters({ node: node, displayLabel: false }) }}
            </div>
        {% endif %}
    {% endblock %}

    {% block title %}
        <h1 class="rz-page-header__title rz-page-header__item">
            {{ title }}
        </h1>
        {% if with_info_badge is defined and with_info_badge and node != null %}
            <div class="rz-page-header__item">
                {{ rz_badge.root({
                    size: 'sm',
                    iconClass: 'rz-icon-ri--information-line',
                    attributes: {
                        is: 'rz-link',
                        href: path('nodeTypeFieldsListPage', {'nodeTypeName': node.nodeTypeName}),
                        title: getNodeType(node).displayName
                    }
                }) }}
            </div>
        {% endif %}
    {% endblock %}

    {% block subtitle %}
        {% if subtitle is defined and subtitle %}
            <div class="rz-page-header__item">
                {{ subtitle }}
            </div>
        {% endif %}
    {% endblock %}

    {% block nav_bar %}
        {% if with_nav_bar is defined and with_nav_bar %}
            {% include '@RoadizRozier/nodes/navBar.html.twig' with {"current": current} %}
        {% endif %}
    {% endblock %}
{% endembed %}
