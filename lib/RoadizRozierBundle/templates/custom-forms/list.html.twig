{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{% trans %}customForms{% endtrans %} | {{ parent() }}{% endblock %}

{% block content %}
<rz-bulk-section>
    {% include '@RoadizRozier/custom-forms/head.html.twig' with {
        title: 'customForms'|trans,
        filters: filters,
        buttons: [{
            label: 'add.a.customForm'|trans,
            attributes: {
                href: path('customFormsAddPage'),
            },
            iconClass: 'rz-icon-ri--add-line',
        }],
    } only %}

    {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
        filters: filters,
        displaySelectAllButton: true,
    }  only %}{% endembed %}
    {% include '@RoadizRozier/ui/patterns/bulk_actions.html.twig' %}

    <article>
        {% include '@RoadizRozier/custom-forms/list_table.html.twig' with {
            selectionAvailable: hasBulkActions,
            actionsAvailable: true,
            items: items,
            filters: filters,
        } only %}
    </article>

</rz-bulk-section>
{% endblock %}
