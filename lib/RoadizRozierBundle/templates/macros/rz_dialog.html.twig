{# rz-dialog: options = Args (storybook/renderer/rzDialog.ts), story Components/Overlay/Dialog #}
{% macro root(options = {}) %}
    {% import '@RoadizRozier/macros/element_attributes.html.twig' as el_attrs %}
    {% import '@RoadizRozier/macros/rz_button.html.twig' as rz_button %}

    {% set element_class = 'rz-dialog' %}
    {% set dialog_id = options.dialogId|default('rz-dialog') %}
    {% set variant = options.variant|default(null) %}
    {% set header = options.header|default(null) %}
    {% set alert = options.alert|default(null) %}
    {% set footer = options.footer|default(null) %}

    {% set attributes = options.attributes|default({})|merge({
        id: dialog_id,
        modal: (options.modal ?? true) ? 'true' : 'false',
        closedby: options.closedby|default('any'),
    }) %}
    {% if alert %}
        {% set attributes = attributes|merge({
            'aria-labelledby': dialog_id ~ '-title',
            'aria-describedby': dialog_id ~ '-text',
        }) %}
    {% endif %}

    <dialog
        is="rz-dialog"
        class="{{ html_classes(element_class, {
            (element_class ~ '--warning'): variant,
            (element_class ~ '--danger'): variant == 'danger',
        }) }}"
        {{ el_attrs.print(attributes) }}
    >
        {% if header %}
            <header class="{{ element_class }}__header">
                {% if header.iconClass is defined and header.iconClass %}
                    <span class="{{ element_class }}__icon {{ header.iconClass }}" aria-hidden="true"></span>
                {% endif %}
                {% if header.title is defined and header.title %}
                    <h1 class="{{ element_class }}__title">{{ header.title }}</h1>
                {% endif %}
                {% if header.closeIconClass is defined and header.closeIconClass %}
                    {{ _self.close(header.closeIconClass) }}
                {% endif %}
            </header>
        {% endif %}

        {% if alert and alert.closeIconClass is defined and alert.closeIconClass %}
            {{ _self.close(alert.closeIconClass) }}
        {% endif %}

        <div class="{{ element_class }}__body">
            {% if alert %}
                <span class="{{ element_class }}__medallion">
                    <span class="{{ alert.iconClass }}" aria-hidden="true"></span>
                </span>
                <div class="{{ element_class }}__group">
                    <h1 class="{{ element_class }}__title" id="{{ dialog_id }}-title">{{ alert.title }}</h1>
                    <p class="{{ element_class }}__text" id="{{ dialog_id }}-text">{{ alert.text }}</p>
                </div>
            {% endif %}
        </div>

        {% if footer and footer.buttons is defined and footer.buttons|length %}
            <footer class="{{ html_classes(element_class ~ '__footer', {
                (element_class ~ '__footer--justify-end'): footer.justifyEnd|default(false),
            }) }}">
                {% for button in footer.buttons %}
                    {{ rz_button.root(button) }}
                {% endfor %}
            </footer>
        {% endif %}
    </dialog>
{% endmacro %}

{% macro close(closeIconClass) %}
    {% import '@RoadizRozier/macros/rz_button.html.twig' as rz_button %}

    {{ rz_button.root({
        iconClass: closeIconClass,
        emphasis: 'tertiary',
        size: 'sm',
        class: 'rz-dialog__close',
        attributes: {
            'aria-label': 'close'|trans,
            type: 'button',
            closetarget: '',
        }
    }) }}
{% endmacro %}
