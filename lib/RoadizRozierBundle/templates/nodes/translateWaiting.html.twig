
{% set currentTitle = node.nodeSources.first.title|default(node.nodeName) %}

{% extends '@RoadizRozier/layout.html.twig' %}

{% block title %}{{ "edit.node.%name%"|trans({'%name%': currentTitle})|truncate_title }} | {{ parent() }}{% endblock %}

{% block customStyles %}
    {{ parent() }}
    {% if try < 30 %}
        <meta http-equiv="refresh" content="2;url={{ path('nodesTranslateWaitingPage', {nodeId: node.id, translationId: translation.id, try: try + 1}) }}">
    {% endif %}
{% endblock %}

{% block content %}
    {% include '@RoadizRozier/nodes/head.html.twig' with {
        node: node,
        title: "edit.node.%name%"|trans({'%name%': currentTitle})|truncate_title,
        current: null,
        with_info_badge: true,
        with_nav_bar: true,
    } only %}

    <section class="rz-page__body">
        {% if try < 30 %}
            <div class="rz-message rz-message--ghost">
                <span class="rz-spinner"></span>
                <p class="rz-message__text">{% trans %}translation_in_progress{% endtrans %}</p>
            </div>
        {% else %}
            {% import '@RoadizRozier/macros/rz_button.html.twig' as rz_button %}
            <div class="rz-message rz-message--warning">
                <span class="rz-icon-ri--error-warning-line"></span>
                <p class="rz-message__text">{% trans %}translation_in_progress.taking_longer{% endtrans %}</p>
            </div>
            <div class="rz-button-group rz-button-group--gap-md">
                {{
                    rz_button.root({
                        emphasis: 'primary',
                        label: 'edit.node',
                        icon: 'rz-icon-ri--edit-line',
                        attributes: {
                            href: path('nodesEditSourcePage', {nodeId: node.id, translationId: translation.id}),
                        },
                    })
                }}
                {{
                    rz_button.root({
                        emphasis: 'secondary',
                        label: 'nodes',
                        icon: 'rz-icon-ri--corner-down-left-line',
                        attributes: {
                            href: path('nodesTreePage'),
                        },
                    })
                }}
            </div>
        {% endif %}
    </section>
{% endblock %}
