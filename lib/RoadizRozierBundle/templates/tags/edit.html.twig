{% extends '@RoadizRozier/layout.html.twig' %}

{%- block title -%}
    {{ "edit.tag.%name%"|trans({'%name%': tag.getTagName })|truncate_title }}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
<section class="content-global edit-tag">
    {% include '@RoadizRozier/tags/head.html.twig' with {
        title: tag.getTranslatedTags.first.getName,
        with_nav_bar: true,
        tag: tag,
        current: 'edit',
        available_translations, available_translations,
        translation: translation,
    } only %}

    <tag-edit-page class="content content-tag-edit">
        {% if readOnly %}
            {% include '@RoadizRozier/ui/patterns/version_banner.html.twig' with {
                current_version: currentVersion,
                revert_form: revertForm,
                working_copy_url: path('tagsEditTranslatedPage', { tagId: tag.id, translationId: translation.id }),
            } only %}
        {% endif %}

        {% form_theme form '@RoadizRozier/forms.html.twig' %}
        {{ form_start(form, { attr: {id: 'edit-tag-form'}}) }}
        {{ form_widget(form) }}
        {% if not readOnly %}
            {% import "@RoadizRozier/ui/components/rz_actions_menu.html.twig" as actions_menu %}
            {{ actions_menu.saveItem({ dataActionSave: '#edit-tag-form' }) }}
        {% endif %}
        {{ form_end(form) }}
    </tag-edit-page>

    {% include '@RoadizRozier/tags/actionsMenu.html.twig' %}
</section>
{% endblock %}
