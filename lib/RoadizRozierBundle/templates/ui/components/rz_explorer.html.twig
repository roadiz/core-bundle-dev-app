{# rz-explorer: options = RzExplorerOptions (storybook/renderer/rzExplorer.ts), story Components/Overlay/Explorer; items and filters are rendered by RzExplorer.ts; placed once in ui/layouts/base #}
{% macro root(options = {}) %}
    {% import '@RoadizRozier/ui/utils/element_attributes.html.twig' as el_attrs %}
    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
    {% import '@RoadizRozier/ui/components/rz_input.html.twig' as rz_input %}

    {% set attributes = {
        'data-more-label': 'more.entities'|trans,
        'data-more-label-document': 'more.documents'|trans,
        'data-more-label-node': 'more.nodes'|trans,
        'data-more-label-node-type': 'more.node_types'|trans,
        'data-more-label-tag': 'more.tags'|trans,
        'data-item-label': 'item'|trans,
        'data-items-label': 'items'|trans,
    }|merge(options.attributes|default({})) %}

    <rz-explorer hidden {{ el_attrs.print(attributes) }}>
        <div class="rz-explorer" data-panel>
            <div class="rz-explorer__inner">
                <div class="rz-explorer__header">
                    {{ rz_button.root({
                        iconClass: 'rz-icon-ri--folders-line',
                        attributes: {
                            type: 'button',
                            hidden: true,
                            'aria-label': 'filter'|trans,
                            'data-action': 'toggle-filters',
                            'data-filter-toggle': true,
                        },
                    }) }}
                    <form action="#" method="POST" class="rz-explorer__search" role="search">
                        {{ rz_input.root({
                            type: 'search',
                            name: 'searchTerms',
                            placeholder: 'search'|trans,
                            attributes: {
                                autocomplete: 'off',
                                'aria-label': 'search'|trans,
                                'data-search': true,
                            },
                        }) }}
                    </form>
                    {{ rz_button.root({
                        iconClass: 'rz-icon-ri--close-line',
                        emphasis: 'secondary',
                        attributes: {
                            type: 'button',
                            'aria-label': 'close'|trans,
                            'data-action': 'close',
                        },
                    }) }}
                </div>

                <div class="rz-explorer__body">
                    {# Filter column: widens the explorer when open, filter items rendered by RzExplorer.ts #}
                    <aside class="rz-explorer__filters" data-filter-panel hidden aria-label="{{ 'filter'|trans }}">
                        {# The column takes the full height (its border reaches the bottom), its content stays in view #}
                        <div class="rz-explorer__filters-inner">
                            <div class="rz-explorer__filters-header">
                                <span class="rz-explorer__filters-count">
                                    <span data-item-count></span>
                                    <span data-item-count-label></span>
                                </span>
                                {{ rz_button.root({
                                    iconClass: 'rz-icon-ri--close-line',
                                    emphasis: 'tertiary',
                                    size: 'xs',
                                    attributes: {
                                        type: 'button',
                                        'aria-label': 'close'|trans,
                                        'data-action': 'toggle-filters',
                                    },
                                }) }}
                            </div>
                            <ul class="rz-explorer__filters-list" data-filter-list>
                                <li class="rz-explorer__filters-item">
                                    {{ rz_button.root({
                                        label: 'see_all',
                                        iconClass: 'rz-icon-ri--list-unordered',
                                        emphasis: 'tertiary',
                                        size: 'sm',
                                        selected: true,
                                        attributes: {
                                            class: 'rz-explorer__filter',
                                            type: 'button',
                                            'aria-pressed': 'true',
                                            'data-action': 'reset-filter',
                                        },
                                    }) }}
                                </li>
                            </ul>
                        </div>
                    </aside>

                    <div class="rz-explorer__main">
                        <div class="rz-explorer__loader" data-loader role="status" hidden>
                            <span class="rz-spinner rz-spinner--lg" aria-hidden="true"></span>
                            <span class="rz-visually-hidden">{{ 'loading'|trans }}</span>
                        </div>
                        <ul class="rz-explorer__list" data-list></ul>

                        {% set load_more_label %}
                            <span class="rz-button__label" data-load-more-label></span>
                            <span class="rz-button__icon rz-icon-ri--add-line"></span>
                            <span class="rz-button__icon rz-spinner"></span>
                        {% endset %}
                        {{ rz_button.root({
                            emphasis: 'primary',
                            innerHTML: load_more_label,
                            attributes: {
                                class: 'rz-explorer__load-more',
                                type: 'button',
                                hidden: true,
                                'data-action': 'load-more',
                            },
                        }) }}

                        <div class="rz-explorer__pagination" data-pagination hidden></div>

                        <div class="rz-explorer__tag-creator" data-tag-creator hidden>
                            <div class="rz-explorer__tag-creator-infos">{{ 'explorer.create_tag'|trans }}</div>
                            {{ rz_button.root({
                                iconClass: 'rz-icon-ri--add-line',
                                emphasis: 'primary',
                                innerHTML: '<span class="rz-button__label" data-tag-name></span>',
                                attributes: {
                                    type: 'button',
                                    'data-action': 'create-tag',
                                },
                            }) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </rz-explorer>
{% endmacro %}
