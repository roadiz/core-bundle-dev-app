{% extends '@RoadizRozier/login/base.html.twig' %}

{% block login_content %}
    {# Authentication errors #}
    {% if authenticationError %}
    <div data-uk-alert class="uk-alert uk-alert-danger">
        <p>{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</p>
    </div>
    {% endif %}

    {# Let the user select the authentication method #}
    {% if availableTwoFactorProviders|length > 1 %}
        <p class="text-body-md rz-login__group">{{ "choose_provider"|trans({}, 'SchebTwoFactorBundle') }}:
            {% for provider in availableTwoFactorProviders %}
                <a href="{{ path("2fa_login", {"preferProvider": provider}) }}">{{ provider }}</a>
            {% endfor %}
        </p>
    {% endif %}

    <form id="two-factor-form"
          class="rz-login__group"
          action="{{ checkPathUrl ? checkPathUrl: path(checkPathRoute) }}"
          method="post">
        <rz-form-field class="rz-form-field rz-form-field--required">
            <div class="rz-form-field__head">
                <label class="rz-form-field__head__label" for="_auth_code">{% trans %}twoFactorCode{% endtrans %}</label>
            </div>
            <input
                is="rz-input"
                id="_auth_code"
                type="text"
                name="{{ authCodeParameterName }}"
                autocomplete="one-time-code"
                autofocus
                class="rz-form-field__body"
                {#
                https://www.twilio.com/blog/html-attributes-two-factor-authentication-autocomplete
                No inputmode/pattern restriction here: this field also accepts
                alphanumeric backup codes, not just numeric TOTP codes.
                #}
            />
            <div class="rz-message rz-message--ghost rz-form-field__message">
                <p class="rz-message__text">{% trans %}twoFactorCode.help{% endtrans %}</p>
            </div>
        </rz-form-field>

        {% if displayTrustedOption %}
            <rz-form-field class="rz-form-field">
                <div class="rz-form-field__head">
                    <label class="rz-form-field__head__label" for="_trusted">{{ "trusted"|trans({}, 'SchebTwoFactorBundle') }}</label>
                </div>
                <input
                    id="_trusted"
                    type="checkbox"
                    class="rz-switch rz-form-field__body"
                    data-on-text="I"
                    data-off-text="O"
                    name="{{ trustedParameterName }}" />
            </rz-form-field>
        {% endif %}

        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}

        <div class="rz-login__group rz-login__group--last rz-login__group--full-width">
            <button type="submit" class="rz-button rz-button--primary">
                <span class="rz-button__label">{{ "login"|trans({}, 'SchebTwoFactorBundle') }}</span>
                <span class="rz-button__icon rz-icon-ri--arrow-right-s-line"></span>
            </button>
        </div>
    </form>
{% endblock %}

{% block login_footer %}
    <a class="rz-button rz-button--secondary" href="{{ logoutPath }}">
        <span class="rz-button__icon rz-icon-ri--corner-down-left-line"></span>
        <span class="rz-button__label">{{ "cancel"|trans({}, 'SchebTwoFactorBundle') }}</span>
    </a>
{% endblock %}
