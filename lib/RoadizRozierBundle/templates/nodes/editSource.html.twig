{% set currentTitle = source.title|default(node.nodeName) %}

{% extends '@RoadizRozier/layout.html.twig' %}
{% import "@RoadizRozier/ui/components/rz_badge.html.twig" as rz_badge %}
{% import "@RoadizRozier/ui/components/rz_page_header.html.twig" as page_header %}

{% block content %}
    {# default(), not ??: the globals are '' (not null) when the env vars are empty #}
    {% set front_origin = custom_preview_scheme|default(custom_public_scheme) %}
    {# null on classic Roadiz, when disabled, without ROLE_ACCESS_LIVE_PREVIEW or the preview required role, and for node-sources with no reachable ancestor (menus, footers…) #}
    {% set live_preview_source = (live_preview.enabled and front_origin and is_granted('ROLE_ACCESS_LIVE_PREVIEW') and is_granted(preview_required_role)) ? source.firstReachableParent : null %}
    {% include '@RoadizRozier/nodes/head.html.twig' with {
        node: node,
        title: ("edit.nodeSource.%name%"|trans({'%name%': currentTitle})),
        translation: translation,
        available_translations: available_translations,
        current: 'source',
        app: app,
        with_debug_badge: true,
        with_info_badge: true,
        with_status_badge: true,
        with_nav_bar: true,
        source: source,
    } only %}

    <section class="rz-page__body">
        {% form_theme form '@RoadizRozier/forms.html.twig' %}
        {{ form_start(form, { attr: {id: 'edit-node-source-form'}}) }}
            {% set groups = {} %}
            {% for child in form %}
                {% if child.vars.name != 'base' %}
                    {% set gCanon = child.vars.attr['data-field-group-canonical']|default('default') %}
                    {% set gLabel = child.vars.attr['data-field-group']|default('default') %}
                    {% if groups[gCanon] is not defined %}
                        {% set groups = groups|merge({
                            (gCanon): {
                                'label': gLabel,
                                'fields': [child]
                            }
                        }) %}
                    {% else %}
                        {% set groups = groups|merge({
                            (gCanon): {
                                'label': groups[gCanon].label,
                                'fields': groups[gCanon].fields|merge([child])
                            }
                        }) %}
                    {% endif %}
                {% else %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}

            {% set defaultGroup = groups['default']|default(null) %}
            {% set orderedGroups = [] %}
            {% for code, data in groups %}
                {% if code != 'default' %}
                    {% set orderedGroups = orderedGroups|merge([{ 'code': code, 'data': data }]) %}
                {% endif %}
            {% endfor %}
            {% if defaultGroup %}
                {% set orderedGroups = [{ 'code': 'default', 'data': defaultGroup }]|merge(orderedGroups) %}
            {% endif %}

            {% if orderedGroups|length > 1 %}
            {% import '@RoadizRozier/ui/components/rz_tablist.html.twig' as rz_tablist %}
            {% set tabs = [] %}
            {% for g in orderedGroups %}
                {% set safeCode = g.code|replace({' ':'-', '_':'-'})|lower %}
                {% set tabs = tabs|merge([{
                    innerHTML: g.code == 'default' ? '<span class="rz-icon-ri--star-line"></span>' : g.data.label|trans|e,
                    selected: loop.first,
                    attributes: { id: 'tab-' ~ safeCode },
                    panel: { id: 'group-' ~ safeCode },
                }]) %}
            {% endfor %}
            {{ rz_tablist.root({ tabs: tabs }) }}
            {% endif %}

            {% for g in orderedGroups %}
                {% set code = g.code %}
                {% set data = g.data %}
                {% set safeCode = code|replace({' ':'-', '_':'-'})|lower %}
                {% set tabId = 'tab-' ~ safeCode %}
                {% set panelId = 'group-' ~ safeCode %}
                {% if orderedGroups|length > 1 %}
                    <div role="tabpanel"
                        aria-labelledby="{{ tabId }}"
                        id="{{ panelId }}"
                        class="rz-tabpanel rz-form__field-list"
                        {% if not loop.first %}hidden{% endif %}
                    >
                {% endif %}
                {% for fieldView in data.fields %}
                    {{ form_row(fieldView) }}
                {% endfor %}
                {% if orderedGroups|length > 1 %}
                    </div>
                {% endif %}
            {% endfor %}
        {% if not readOnly %}
            {% import "@RoadizRozier/ui/components/rz_actions_menu.html.twig" as actions_menu %}
            {{ actions_menu.saveItem({ dataActionSave: '#edit-node-source-form' }) }}
        {% endif %}
        {{ form_end(form) }}
        {% if live_preview_source %}
            <rz-live-preview id="live-preview"
                             class="rz-live-preview"
                             data-src="{{ path('nodesSourcesPreviewRedirect', { nodeSourceId: live_preview_source.id }) }}"
                             data-front-origin="{{ front_origin }}"
                {# Only a block is singled out in the preview: the page itself needs no target. #}
                {% if source.id != live_preview_source.id %}data-node-source-id="{{ source.id }}"{% endif %}>
                {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
                {% import '@RoadizRozier/ui/components/rz_badge.html.twig' as rz_badge %}
                <div class="rz-live-preview__toolbar">
                    <div class="rz-button-group" role="group" aria-label="{% trans %}live_preview.viewport{% endtrans %}">
                        {% for width in live_preview.viewport_widths %}
                            {% set icon = width < 600 ? 'smartphone-line' : (width < 1024 ? 'tablet-line' : 'computer-line') %}
                            {{ rz_button.root({
                                emphasis: 'tertiary',
                                size: 'sm',
                                iconClass: 'rz-icon-ri--' ~ icon,
                                attributes: {
                                    type: 'button',
                                    'data-width': width,
                                    'aria-pressed': 'false',
                                    'aria-label': width ~ ' px',
                                    title: width ~ ' px',
                                },
                            }) }}
                        {% endfor %}
                    </div>
                    {{ rz_badge.root({
                        size: 'xs',
                        label: '100 %',
                        attributes: { class: 'rz-live-preview__scale' },
                    }) }}
                    {{ rz_button.root({
                        emphasis: 'tertiary',
                        size: 'sm',
                        iconClass: 'rz-icon-ri--close-line',
                        attributes: {
                            type: 'button',
                            'data-close': true,
                            'aria-label': 'live_preview.close'|trans,
                            title: 'live_preview.close'|trans,
                        },
                    }) }}
                </div>
                <div class="rz-live-preview__viewport">
                    <iframe title="{% trans %}live_preview{% endtrans %}"></iframe>
                </div>
            </rz-live-preview>
        {% endif %}
    </section>

    {% include '@RoadizRozier/nodes/actionsMenu.html.twig' %}
{% endblock %}
