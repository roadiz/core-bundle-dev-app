{% embed "@RoadizRozier/ui/components/rz_actions_menu.html.twig" with {
    vertical: true,
    class: 'actions-menu',
    item: item
} only %}
    {% block items %}
        {% if item.id and is_granted('ROLE_ACCESS_WEBHOOKS') %}
            {{ _self.deleteItem({ attributes: { href: path('webhooksDeletePage', { id: item.id }) } }) }}
            {{ _self.item({ button: {
                label: 'webhook.trigger',
                iconClass: 'rz-icon-ri--space-ship-line',
                attributes: {
                    href: path('webhooksTriggerPage', { id: item.id }),
                },
            } }) }}
        {% endif %}
    {% endblock %}
{% endembed %}
