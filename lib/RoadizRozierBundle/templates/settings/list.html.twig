{% extends '@RoadizRozier/layout.html.twig' %}

{%- block title -%}
    {{ settingGroup.name|trans }}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
    <section class="content-global content-nav-and-filters">
        {% if settingGroup %}
            {% set title = settingGroup.name|trans %}
            {% set href = path('settingsExportGroupPage', {settingGroupId: settingGroup.id}) %}
        {% else %}
            {% set title = 'settings'|trans %}
            {% set href = path('settingsExportAllPage') %}
        {% endif %}
        {% include '@RoadizRozier/settings/head.html.twig' with {
            title: title,
            filters: filters,
            buttons: [
                {
                    label: 'add.a.setting'|trans,
                    attributes : {
                        href: path('settingsAddPage'),
                    },
                    iconClass: 'rz-icon-ri--add-line',
                },
                {
                    label: 'import'|trans,
                    attributes : {
                        href: path('settingsImportPage'),
                    },
                    iconClass: 'rz-icon-ri--upload-line',
                },
                {
                    label: 'export'|trans,
                    attributes : {
                        class: 'rz-no-ajax-link',
                        href: href
                    },
                    iconClass: 'rz-icon-ri--download-line',
                }
            ],
        } only %}
        {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
            filters: filters,
        }  only %}{% endembed %}

        <article>
            {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
                actionsAvailable: true,
                selectionAvailable: false,
            } %}
                {% block thead_cells %}
                    {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
                    <th>
                        {{ rz_table.column_ordering({
                            field: 'name',
                            filters: filters,
                            label: 'name'|trans,
                        }) }}
                    </th>
                    <th class="mobile-hidden">{% trans %}value{% endtrans %}</th>
                {% endblock %}

                {% block tbody_content %}
                    {% for setting in settings %}
                        {% set edit_href = path('settingsEditPage', { settingId: setting.setting.getId }) %}
                        <tr class="setting-row">
                            <td class="rz-table__cell rz-table__cell--sm">
                                <p>
                                    <a href="{{ edit_href }}">
                                        {{ setting.setting.name|trans|inlineMarkdown -}}
                                    </a>
                                </p>
                                {% if setting.setting.description %}
                                    <p class="rz-table__cell--muted">{{ setting.setting.description|trans|inlineMarkdown }}</p>
                                {% endif %}
                            </td>
                            <td class="mobile-hidden">
                                {% if setting.document %}
                                    <figure>{{- setting.document|display({height:30}) -}}</figure>
                                {% endif %}
                                {% form_theme setting.form '@RoadizRozier/form/horizontal_forms.html.twig' %}
                                {{ form_start(setting.form, { attr: { class: 'rz-form-field--head-hidden'}}) }}
                                    {{ form_widget(setting.form) }}
                                    {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
                                    {{ rz_button.root({
                                        iconClass: 'rz-icon-ri--save-line',
                                        attributes: {
                                            type: 'submit',
                                            title: 'save'|trans,
                                            style: 'display: none;',
                                        }
                                    }) }}
                                {{ form_end(setting.form) }}
                            </td>
                            {% if actionsAvailable %}
                                <td>
                                    {% include '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                                        'editHref': edit_href,
                                        'deleteHref': path('settingsDeletePage', { settingId: setting.setting.getId }),
                                        'saveHref': '#',
                                        'saveClass': 'rz-button-settings-save',
                                    } only %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        </article>
    </section>
{% endblock %}
