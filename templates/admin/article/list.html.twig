{% extends "@RoadizRozier/ui/layouts/admin.html.twig" %}

{%- block header -%}
    {# This page is the section root, so the trail is just its own name. #}
    {% include '@RoadizRozier/ui/patterns/page_header.html.twig' with {
        title: 'articles'|trans,
        breadcrumb: { current: 'articles'|trans },
        filters: filters,
        buttons: [
            {
                label: 'articles.add'|trans,
                attributes : {
                    href: path('appArticlesAddPage'),
                },
                iconClass: 'rz-icon-ri--add-line',
            }
        ]
    } only %}
{%- endblock -%}

{%- block content_filters -%}
    {% embed "@RoadizRozier/ui/components/rz_filters_bar.html.twig" with {
        filters: filters,
        displaySelectAllButton: true,
        tags: tags,
        currentTag: currentTag,
    } only %}
        {% block before_submit %}
            {% import '@RoadizRozier/ui/components/rz_select.html.twig' as rz_select %}
            {% set tag_options = [{ value: '', label: 'filter.by_tag.all'|trans }] %}
            {% for tagGroupName, tagGroup in tags %}
                {% set group_options = [] %}
                {% for tag in tagGroup %}
                    {% set group_options = group_options|merge([{
                        value: tag.id,
                        label: tag.name,
                        selected: currentTag.id is defined and currentTag.id == tag.id,
                    }]) %}
                {% endfor %}
                {% set tag_options = tag_options|merge([{ label: tagGroupName, options: group_options }]) %}
            {% endfor %}
            {{ rz_select.root({
                options: tag_options,
                attributes: {
                    name: 'tag',
                    'aria-label': 'filter.by_tag'|trans,
                },
            }) }}
        {% endblock %}
    {% endembed %}
    {% include '@RoadizRozier/ui/patterns/bulk_actions.html.twig' %}
{%- endblock -%}

{%- block content_body -%}
    <article>
        {% embed '@RoadizRozier/ui/components/rz_table.html.twig' with {
            selectionAvailable: true,
            actionsAvailable: true,
            items: items
        } only %}
            {% block thead_cells %}
                {% import '@RoadizRozier/ui/components/rz_table.html.twig' as rz_table %}
                <th>
                    {{ rz_table.column_ordering({
                        field: 'title',
                        label: 'article.title'|trans,
                        filters: filters|default(null),
                    }) }}
                </th>
                <th>
                    {{ rz_table.column_ordering({
                        field: 'publishedAt',
                        label: 'article.published_at'|trans,
                        filters: filters|default(null),
                    }) }}
                </th>
                <th>
                    {{ rz_table.column_ordering({
                        field: 'node.createdAt',
                        label: 'article.created_at'|trans,
                        filters: filters|default(null),
                    }) }}
                </th>
                <th>
                    {% trans %}article.status{% endtrans %}
                </th>
                <th>
                    {% trans %}article.tags{% endtrans %}
                </th>
            {% endblock %}
            {% block tbody_content %}
                {% for item in items %}
                    {% set itemEditUrl = path('nodesEditSourcePage', {
                        nodeId: item.node.id,
                        translationId: item.translation.id,
                    }) %}
                    <tr>
                        {{ _self.selection_input({ selectionAvailable: selectionAvailable, value: item.id, disabled: item.node.locked }) }}
                        <td  class="rz-table__cell--flex">
                            <rz-entity-thumbnail
                                entity-class="App\GeneratedEntity\NSArticle"
                                entity-id="{{ item.id }}"
                            ></rz-entity-thumbnail>
                            {% import '@RoadizRozier/ui/components/rz_link.html.twig' as rz_link %}
                            {{ rz_link.root({
                                label: item.title,
                                attributes: { class: "rz-table__cell--ellipsis", href: itemEditUrl },
                            }) }}
                        </td>
                        <td>{{- item.publishedAt ? item.publishedAt|format_datetime('short', 'short', locale=app.request.locale) : '-' -}}</td>
                        <td>{{- item.node.createdAt|format_datetime('short', 'short', locale=app.request.locale) -}}</td>
                        <td>
                            {% import "@RoadizRozier/ui/components/rz_node_badge.html.twig" as rz_node_badge %}
                            {{ rz_node_badge.all({ node: item.node, displayLabel: false }) }}
                        </td>
                        <td>
                            {% import "@RoadizRozier/ui/components/rz_badge.html.twig" as rz_badge %}
                            {%- for tag in item.node.tags -%}
                                {{ rz_badge.root({
                                    label: tag.name,
                                })}}
                            {%- endfor -%}
                        </td>
                        {% if actionsAvailable %}
                            <td>
                                {% embed '@RoadizRozier/ui/components/rz_table_actions.html.twig' with {
                                    'editHref': itemEditUrl,
                                    'deleteHref': workflow_can(item.node, 'delete') ? path('nodesDeletePage', { nodeId: item.node.id }) : null,
                                } %}
                                    {% block other_actions %}
                                        {{ _self.button({
                                            iconClass: 'uk-icon-rz-node-tree-mini',
                                            attributes: {
                                                href: path('nodesTreePage', { nodeId: item.node.id }),
                                                title: 'see.nodetree'|trans,
                                            }
                                        }) }}
                                        {% if workflow_can(item.node, 'undelete') %}
                                            {{ _self.button({
                                                iconClass: 'uk-icon-rz-untrash',
                                                attributes: {
                                                    href: path('nodesUndeletePage', { nodeId: item.node.id }),
                                                    title: 'undelete'|trans,
                                                }
                                            })}}
                                        {% endif %}
                                    {% endblock %}
                                {% endembed %}
                            </td>
                        {% endif %}
                    </tr>
                {%- else -%}
                    <tr>
                        <td colspan="8">{% trans %}no_article{% endtrans %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    </article>
{%- endblock -%}
