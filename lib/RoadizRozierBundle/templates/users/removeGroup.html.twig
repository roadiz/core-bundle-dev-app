{% extends '@RoadizRozier/layout.html.twig' %}

{%- block title -%}
    {{- "remove.user.%name%.from.group.%group%"|trans({'%name%': user.username, '%group%': group.getName})|truncate_title }}
    |
    {{ parent() -}}
{%- endblock -%}

{% block content %}
<section class="content-global delete-user">
    {% set page_title = "remove.user.%name%.from.group.%group%"|trans({'%name%': user.username, '%group%': group.getName})|truncate_title %}
    {% include '@RoadizRozier/ui/patterns/page_header.html.twig' with {
        title: page_title,
        breadcrumb: {
            parents: [breadcrumb_root('users'), {
                label: user.username,
                url: path('usersEditPage', { id: user.id }),
            }],
            current: page_title,
        },
    } only %}

    <article class="content content-delete content-no-action-menu">
        {% form_theme form '@RoadizRozier/forms.html.twig' %}
        <form action="#" method="post">
            {{ form_widget(form) }}
            {% import '@RoadizRozier/ui/components/rz_message.html.twig' as rz_message %}
            {% import '@RoadizRozier/ui/components/rz_button.html.twig' as rz_button %}
            {{ rz_message.root({ color: 'error', text: 'are_you_sure.remove.user.from.group'|trans, attributes: { class: 'rz-form-field__message' } }) }}
            <div class="rz-button-group rz-button-group--gap-md">
                {{ rz_button.root({
                    emphasis: 'secondary',
                    label: 'cancel',
                    iconClass: 'rz-icon-ri--corner-down-left-line',
                    attributes: { href: path('usersEditGroupsPage', { userId: user.getId }) },
                }) }}
                {{ rz_button.root({
                    emphasis: 'primary',
                    color: 'danger',
                    label: 'remove',
                    iconClass: 'rz-icon-ri--delete-bin-7-line',
                    attributes: { type: 'submit' },
                }) }}
            </div>
        </form>
    </article>
</section>
{% endblock %}
