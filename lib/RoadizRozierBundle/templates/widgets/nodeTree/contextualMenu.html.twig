 {% import "@RoadizRozier/ui/components/rz_dropdown.html.twig" as rz_dropdown %}
<div class="rz-dropdown">
    <div class="rz-dropdown__head">
        <div class="rz-dropdown__title">{% trans %}actions{% endtrans %} | {{ node.nodeName|truncate_title(18) }}</div>
        <div class="rz-dropdown__info-list">
            {% import '@RoadizRozier/ui/components/rz_node_badge.html.twig' as rz_node_badge %}
            {{ rz_node_badge.parameters({ node: node, displayLabel: false }) }}
            {{ rz_node_badge.status({ node: node, displayLabel: false }) }}
        </div>
    </div>

    {% if is_granted('CREATE', node) or is_granted('EDIT_SETTING', node) %}
        <menu class="rz-dropdown__list">
            {% if is_granted('CREATE', node) %}
                {{ rz_dropdown.item({
                    label: 'add.a.child.node'|trans,
                    iconClass: 'rz-icon-ri--add-line',
                    attributes: { href: path('nodesAddChildPage', { nodeId: node.id }) },
                }) }}
            {%- endif -%}
            {% if is_granted('EDIT_SETTING', node) %}
                {{ rz_dropdown.item({
                        label: 'edit.node'|trans,
                        iconClass: 'rz-icon-ri--edit-line',
                        attributes: { href: path('nodesEditPage', { nodeId:node.id }) },
                    }) }}

                {%- if not node.Locked -%}
                    {{ rz_dropdown.item({
                        label: 'move.node.to.first.position'|trans,
                        iconClass: 'rz-icon-ri--arrow-up-line',
                        attributes: {
                            class: 'move-node-first-position',
                            'type': 'button',
                            'command': '--move-first',
                            'commandfor': 'DYNAMICALLY_SET_BY_JS',
                        }
                    }) }}
                    {{ rz_dropdown.item({
                        label: 'move.node.to.last.position'|trans,
                        iconClass: 'rz-icon-ri--arrow-down-line',
                        attributes: {
                            'type': 'button',
                            'command': '--move-last',
                            'commandfor': 'DYNAMICALLY_SET_BY_JS',
                        }
                    }) }}
                {%- endif -%}
            {%- endif -%}
        </menu>
    {%- endif -%}

     {% if is_granted('DUPLICATE', node) %}
        <menu class="rz-dropdown__list">
            {{ rz_dropdown.item({
                label: 'node.copy'|trans,
                iconClass: 'rz-icon-ri--file-copy-line',
                attributes: {
                    'type': 'button',
                    'command': '--copy',
                    'commandfor': 'DYNAMICALLY_SET_BY_JS',
                }
            }) }}
            {{ rz_dropdown.item({
                label: 'node.paste_inside'|trans,
                iconClass: 'rz-icon-ri--file-copy-line',
                attributes: {
                    'type': 'button',
                    'command': '--paste-inside',
                    'commandfor': 'DYNAMICALLY_SET_BY_JS',
                    disabled: 'true',
                }
            }) }}
            {{ rz_dropdown.item({
                label: 'node.paste_after'|trans,
                iconClass: 'rz-icon-ri--file-copy-line',
                attributes: {
                    'type': 'button',
                    'command': '--paste-after',
                    'commandfor': 'DYNAMICALLY_SET_BY_JS',
                    disabled: 'true',
                }
            }) }}
            {{ rz_dropdown.item({
                label: 'node.duplicate'|trans,
                iconClass: 'rz-icon-ri--file-copy-line',
                attributes: {
                    'type': 'button',
                    'command': '--duplicate',
                    'commandfor': 'DYNAMICALLY_SET_BY_JS',
                }
            }) }}
        </menu>
    {%- endif -%}

     {% if not node.locked and is_granted('EDIT_STATUS', node)%}
        <menu class="rz-dropdown__list">
            {% if node.visible %}
                {{ rz_dropdown.item({
                    label: 'node.hide'|trans,
                    iconClass: 'rz-icon-ri--eye-off-line',
                    attributes: {
                        class: "hide-node",
                        'command': '--update-status',
                        'commandfor': 'DYNAMICALLY_SET_BY_JS',
                        'data-status': "visible",
                        'data-value': "0",
                        'type': "button",
                    }
                }) }}
            {% else %}
                {{ rz_dropdown.item({
                    label: 'node.show'|trans,
                    iconClass: 'rz-icon-ri--eye-line',
                    attributes: {
                        class: "show-node",
                        'command': '--update-status',
                        'commandfor': 'DYNAMICALLY_SET_BY_JS',
                        'data-status': "visible",
                        'data-value': "1",
                        'type': "button",
                    }
                }) }}
            {% endif %}
            {% if not node.published and workflow_can(node, 'publish') %}
                {{ rz_dropdown.item({
                    label: 'node.publish'|trans,
                    iconClass: 'rz-icon-rz--status-published-line',
                    attributes: {
                        'command': '--update-status',
                        'commandfor': 'DYNAMICALLY_SET_BY_JS',
                        'data-status': "status",
                        'data-value': "publish",
                        'type': "button",
                    }
                }) }}
            {% elseif node.published and workflow_can(node, 'reject') %}
                {{ rz_dropdown.item({
                    label: 'node.unpublish'|trans,
                    iconClass: 'rz-icon-rz--status-draft-line',
                    attributes: {
                        'command': '--update-status',
                        'commandfor': 'DYNAMICALLY_SET_BY_JS',
                        'data-status': "status",
                        'data-value': "reject",
                        'type': "button",
                    }
                }) }}
            {% endif %}
        </menu>

        {% if workflow_can(node, 'delete') %}
            <menu class="rz-dropdown__list">
                {% set refererUrl = node.parent ? getBreadcrumbsItem(node.parent).url : null %}
                {{ rz_dropdown.item({
                    label: 'delete.node'|trans,
                    iconClass: 'rz-icon-ri--delete-bin-7-line',
                    attributes: {
                        href: path('nodesDeletePage', { nodeId: node.id, referer: refererUrl }),
                        'aria-label': "delete.node.%name%"|trans({'%name%': node.nodeName}),
                    }
                }) }}
            </menu>
        {% endif %}
    {% endif %}
</div>
